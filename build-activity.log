18:00:15 out   }
18:00:15 out   }
18:00:15 out   if self.config_dirty {
18:00:15 out   self.save_timer += dt;
18:00:15 out   if self.save_timer >= CONFIG_SAVE_DELAY {
18:00:15 out   self.save_config();
18:00:15 out   }
18:00:15 out   }
18:00:15 out   match self.state {
18:00:15 out   JukeboxState::Inserting => {
18:00:15 out   self.anim_t += dt / INSERT_SECS;
