20:06:55 out   );
20:06:55 out   painter.rect_filled(slot, 0.0, Color32::from_rgba_unmultiplied(0, 0, 0, 130));
20:06:55 out   if let Some(index) = self.inserted {
20:06:55 out   let slot_size = rect.width() * 0.40;
