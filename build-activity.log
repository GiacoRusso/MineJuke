19:17:37 out   [package]
19:17:37 out   name = "minecraft-jukebox"
19:17:37 out   version = "1.0.0"
19:17:37 out   edition = "2021"
19:17:37 out   description = "A native Minecraft-styled music disc jukebox for macOS"
19:17:37 out   license = "MIT"
19:17:37 out   # Keep the app a single, standalone Cargo project even though this workspace's
19:17:37 out   # parent folder once carried a virtual workspace manifest. Craft Anything builds
19:17:37 out   # from app/, so the executable must land in app/target.
19:17:37 out   [workspace]
19:17:37 out   [dependencies]
19:17:37 out   eframe = { version = "0.29.1", default-features = false, features = ["glow", "default_fonts"] }
19:17:37 out   egui = "0.29.1"
19:17:37 out   rodio = { version = "0.20.1", default-features = false, features = ["symphonia-vorbis"] }
19:17:37 out   # rodio 0.20's `symphonia-vorbis` feature enables the codec but not the Ogg
19:17:37 out   # container, so pull in the demuxer explicitly.
19:17:37 out   symphonia = { version = "0.5", default-features = false, features = ["ogg", "vorbis"] }
19:17:37 out   serde = { version = "1", features = ["derive"] }
19:17:37 out   serde_json = "1"
19:17:37 out   rfd = { version = "0.17.2", default-features = false }
