17:52:23 out   --- main
17:52:23 out   //! Minecraft Jukebox - a native macOS music disc player.
17:52:23 out   //!
17:52:23 out   //! Run normally:
17:52:23 out   //! cargo run --release
17:52:23 out   //!
17:52:23 out   //! Capture the rendered window (used by the build checker):
17:52:23 out   //! cargo run --release -- --screenshot shots/now.png
17:52:23 out   //!
17:52:23 out   //! Drive the core loop headlessly and write a report:
17:52:23 out   //! cargo run --release -- --self-test shots/self-test.json
17:52:23 out   mod app;
17:52:23 out   mod assets;
17:52:23 out   mod disc;
17:52:23 out   mod player;
17:52:23 out   mod selftest;
17:52:23 out   mod style;
17:52:23 out   mod textures;
17:52:23 out   use app::{JukeboxApp, Startup, MIN_WINDOW_H, MIN_WINDOW_W, WINDOW_H, WINDOW_W};
17:52:23 out   use std::path::PathBuf;
17:52:23 out   fn main() -> eframe::Result<()> {
17:52:23 out   let mut screenshot = None;
17:52:23 out   let mut self_test = None;
17:52:23 out   let mut args = std::env::args().skip(1);
17:52:23 out   while let Some(arg) = args.next() {
17:52:23 out   match arg.as_str() {
17:52:23 out   "--screenshot" => {
17:52:23 out   screenshot = args.next().map(PathBuf::from);
17:52:23 out   if screenshot.is_none() {
17:52:23 out   eprintln!("--screenshot needs a PNG path");
17:52:23 out   std::process::exit(2);
17:52:23 out   }
17:52:23 out   }
17:52:23 out   "--self-test" => {
17:52:23 out   self_test = args.next().map(PathBuf::from);
17:52:23 out   if self_test.is_none() {
17:52:23 out   eprintln!("--self-test needs a JSON path");
17:52:23 out   std::process::exit(2);
17:52:23 out   }
17:52:23 out   }
17:52:23 out   "--help" | "-h" => {
17:52:23 out   println!("Minecraft Jukebox");
17:52:23 out   println!(" --screenshot <file.png> draw 120 frames, save a PNG and exit");
17:52:23 out   println!(" --self-test <file.json> run the headless core-loop test and exit");
17:52:23 out   return Ok(());
17:52:23 out   }
17:52:23 out   _ => {}
17:52:23 out   }
17:52:23 out   }
17:52:23 out   if let Some(path) = self_test {
17:52:23 out   if !selftest::run(path) {
17:52:23 out   std::process::exit(1);
17:52:23 out   }
17:52:23 out   return Ok(());
17:52:23 out   }
17:52:23 out   let options = eframe::NativeOptions {
17:52:23 out   viewport: eframe::egui::ViewportBuilder::default()
17:52:23 out   .with_title("Minecraft Jukebox")
17:52:23 out   .with_inner_size([WINDOW_W, WINDOW_H])
17:52:23 out   .with_min_inner_size([MIN_WINDOW_W, MIN_WINDOW_H])
17:52:23 out   .with_resizable(true),
17:52:23 out   renderer: eframe::Renderer::Glow,
17:52:23 out   vsync: true,
17:52:23 out   multisampling: 0,
17:52:23 out   ..Default::default()
17:52:23 out   };
17:52:23 out   let startup = Startup {
17:52:23 out   screenshot,
17:52:23 out   self_test: None,
17:52:23 out   };
17:52:23 out   eframe::run_native(
17:52:23 out   "Minecraft Jukebox",
17:52:23 out   options,
17:52:23 out   Box::new(move |cc| Ok(Box::new(JukeboxApp::new(cc, startup)))),
17:52:23 out   )
17:52:23 out   }
