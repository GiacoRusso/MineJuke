20:05:36 out   impl eframe::App for JukeboxApp {
20:05:36 out   fn update(&mut self, ctx: &egui::Context, _frame: &mut eframe::Frame) {
20:05:36 out   let dt = ctx.input(|i| i.stable_dt).clamp(0.0, 0.1);
20:05:36 out   if let Some(path) = &self.screenshot_path {
20:05:36 out   if let Some(image) = take_screenshot(ctx) {
20:05:36 out   match save_screenshot(path, &image) {
20:05:36 out   Ok(()) => {
20:05:36 out   eprintln!("Screenshot saved to {}", path.display());
20:05:36 out   std::process::exit(0);
20:05:36 out   }
20:05:36 out   Err(err) => {
20:05:36 out   eprintln!("Could not save screenshot: {err}");
20:05:36 out   std::process::exit(2);
20:05:36 out   }
20:05:36 out   }
20:05:36 out   }
20:05:36 out   if self.frame_count == 8 && !self.demo_started {
20:05:36 out   self.demo_started = true;
20:05:36 out   // Only show a disc in the screenshot when the selected
20:05:36 out   // Minecraft installation really has it. Otherwise the shot
20:05:36 out   // should show the empty jukebox and the friendly folder
20:05:36 out   // banner instead of pretending music is available.
20:05:36 out   let index = self.library.as_ref().and_then(|lib| {
20:05:36 out   DISCS
20:05:36 out   .iter()
20:05:36 out   .position(|disc| disc.id == "cat" && lib.has_disc(disc))
20:05:36 out   .or_else(|| DISCS.iter().position(|disc| lib.has_disc(disc)))
20:05:36 out   });
20:05:36 out   if let Some(index) = index {
20:05:36 out   self.selected = index;
20:05:36 out   self.begin_insert(index);
20:05:36 out   }
20:05:36 out   }
20:05:36 out   }
20:05:36 out   self.handle_input(ctx);
20:05:36 out   self.advance(dt);
20:05:36 out   self.render(ctx);
20:05:36 out   if let Some(path) = &self.screenshot_path {
20:05:36 out   if self.frame_count >= 120 {
20:05:36 out   self.screenshot_requested = true;
20:05:36 out   ctx.send_viewport_cmd(ViewportCommand::Screenshot);
20:05:36 out   }
20:05:36 out   if self.frame_count > 260 && self.screenshot_requested {
20:05:36 out   eprintln!(
20:05:36 out   "Screenshot mode timed out while waiting for {}",
20:05:36 out   path.display()
20:05:36 out   );
20:05:36 out   std::process::exit(2);
20:05:36 out   }
20:05:36 out   ctx.request_repaint();
20:05:36 out   } else if matches!(
20:05:36 out   self.state,
20:05:36 out   JukeboxState::Inserting | JukeboxState::Playing | JukeboxState::Ejecting
20:05:36 out   ) || !self.notes.is_empty()
20:05:36 out   {
20:05:36 out   ctx.request_repaint_after(Duration::from_millis(16));
20:05:36 out   } else {
20:05:36 out   ctx.request_repaint_after(Duration::from_millis(100));
20:05:36 out   }
20:05:36 out   self.frame_count = self.frame_count.saturating_add(1);
20:05:36 out   }
20:05:36 out   fn on_exit(&mut self, _gl: Option<&eframe::glow::Context>) {
20:05:36 out   // Volume and repeat are saved on a short delay while the window is
20:05:36 out   // open. Flush a pending change when the person closes the app.
20:05:36 out   if self.config_dirty {
20:05:36 out   self.save_config();
20:05:36 out   }
20:05:36 out   }
20:05:36 out   }
20:05:36 out   impl Drop for JukeboxApp {
20:05:36 out   fn drop(&mut self) {
20:05:36 out   // Flush a pending volume/repeat change if the window closes before the
20:05:36 out   // debounce timer fires. Demo/headless runs never touch the real config.
20:05:36 out   if self.config_dirty && !self.demo_mode {
20:05:36 out   self.save_config();
20:05:36 out   }
20:05:36 out   }
20:05:36 out   }
20:05:36 out   fn take_screenshot(ctx: &egui::Context) -> Option<std::sync::Arc<egui::ColorImage>> {
20:05:36 out   ctx.input(|input| {
20:05:36 out   input.events.iter().find_map(|event| {
20:05:36 out   if let egui::Event::Screenshot { image, .. } = event {
20:05:36 out   Some(image.clone())
20:05:36 out   } else {
20:05:36 out   None
20:05:36 out   }
20:05:36 out   })
20:05:36 out   })
20:05:36 out   }
20:05:36 out   fn save_screenshot(path: &Path, image: &egui::ColorImage) -> anyhow::Result<()> {
20:05:36 out   if let Some(parent) = path.parent().filter(|p| !p.as_os_str().is_empty()) {
20:05:36 out   std::fs::create_dir_all(parent)?;
20:05:36 out   }
20:05:36 out   let width = image.size[0] as u32;
20:05:36 out   let height = image.size[1] as u32;
20:05:36 out   let mut rgba = Vec::with_capacity(image.pixels.len() * 4);
20:05:36 out   for pixel in &image.pixels {
20:05:36 out   rgba.extend_from_slice(&pixel.to_array());
20:05:36 out   }
20:05:36 out   image::save_buffer(path, &rgba, width, height, image::ColorType::Rgba8)?;
20:05:36 out   Ok(())
20:05:36 out   }
20:05:36 out   fn ease_out(t: f32) -> f32 {
20:05:36 out   1.0 - (1.0 - t).powi(3)
20:05:36 out   }
20:05:36 out   fn config_path() -> PathBuf {
20:05:36 out   if let Ok(path) = std::env::var("MINECRAFT_JUKEBOX_CONFIG") {
20:05:36 out   return PathBuf::from(path);
20:05:36 out   }
20:05:36 out   let base = dirs::config_dir()
20:05:36 out   .or_else(dirs::home_dir)
20:05:36 out   .unwrap_or_else(|| PathBuf::from("."));
20:05:36 out   base.join("MinecraftJukebox").join("config.json")
20:05:36 out   }
