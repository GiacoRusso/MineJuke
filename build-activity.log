18:00:15 out   } else if hovered {
18:00:15 out   Color32::from_rgb(176, 124, 36)
18:00:15 out   } else {
18:00:15 out   Color32::from_rgb(148, 102, 28)
18:00:15 out   }
18:00:15 out   } else if pressed {
18:00:15 out   BUTTON_PRESSED
18:00:15 out   } else if hovered {
18:00:15 out   BUTTON_HOVER
18:00:15 out   } else {
18:00:15 out   BUTTON
18:00:15 out   };
18:00:15 out   let painter = ui.painter();
18:00:15 out   painter.rect_filled(rect, 0.0, fill);
18:00:15 out   painter.rect_stroke(rect, 0.0, Stroke::new(2.0_f32, OUTLINE));
18:00:15 out   if !pressed {
18:00:15 out   paint_bevel(painter, rect.shrink(2.0), 2.0);
18:00:15 out   }
18:00:15 out   if active {
18:00:15 out   painter.rect_stroke(rect.shrink(3.0), 0.0, Stroke::new(1.0_f32, GOLD));
18:00:15 out   }
18:00:15 out   pixel_text(
18:00:15 out   painter,
18:00:15 out   rect.center(),
18:00:15 out   Align2::CENTER_CENTER,
18:00:15 out   label,
18:00:15 out   6.0,
18:00:15 out   if enabled { TEXT } else { MUTED_DARK },
18:00:15 out   );
18:00:15 out   response
18:00:15 out   }
18:00:15 out   pub fn status_pill(ui: &mut Ui, text: &str, color: Color32) {
18:00:15 out   let font = FontId::proportional(6.0);
18:00:15 out   let galley = ui
18:00:15 out   .painter()
18:00:15 out   .layout_no_wrap(text.to_owned(), font.clone(), color);
18:00:15 out   let size = galley.size() + Vec2::new(18.0, 12.0);
18:00:15 out   let (rect, _) = ui.allocate_exact_size(size, Sense::hover());
18:00:15 out   let painter = ui.painter();
18:00:15 out   painter.rect_filled(rect, 0.0, Color32::from_rgb(17, 19, 23));
18:00:15 out   painter.rect_stroke(rect, 0.0, Stroke::new(1.0_f32, color.gamma_multiply(0.6)));
18:00:15 out   painter.rect_filled(
18:00:15 out   Rect::from_min_size(rect.min + Vec2::splat(5.0), Vec2::splat(4.0)),
18:00:15 out   0.0,
18:00:15 out   color,
18:00:15 out   );
18:00:15 out   painter.text(
18:00:15 out   rect.center() + Vec2::new(5.0, 0.0),
18:00:15 out   Align2::CENTER_CENTER,
18:00:15 out   text,
18:00:15 out   font,
18:00:15 out   color,
18:00:15 out   );
18:00:15 out   }
18:00:15 out   pub fn slider(ui: &mut Ui, value: &mut f32, width: f32) -> (Response, bool) {
18:00:15 out   let (rect, response) = ui.allocate_exact_size(Vec2::new(width, 26.0), Sense::click_and_drag());
18:00:15 out   let mut changed = false;
18:00:15 out   if response.clicked() || response.dragged() {
18:00:15 out   if let Some(pos) = ui.ctx().pointer_interact_pos() {
18:00:15 out   let new = ((pos.x - rect.left()) / rect.width().max(1.0)).clamp(0.0, 1.0);
18:00:15 out   if (new - *value).abs() > 0.001 {
18:00:15 out   *value = new;
18:00:15 out   changed = true;
18:00:15 out   }
18:00:15 out   }
18:00:15 out   }
18:00:15 out   let painter = ui.painter();
18:00:15 out   let track = Rect::from_center_size(rect.center(), Vec2::new(rect.width(), 12.0));
18:00:15 out   painter.rect_filled(track, 0.0, PANEL_DEEP);
18:00:15 out   painter.rect_stroke(track, 0.0, Stroke::new(1.0_f32, OUTLINE));
18:00:15 out   let fill = Rect::from_min_max(
18:00:15 out   track.min + Vec2::splat(2.0),
18:00:15 out   Pos2::new(
18:00:15 out   track.left() + 2.0 + (track.width() - 4.0) * value.clamp(0.0, 1.0),
18:00:15 out   track.bottom() - 2.0,
18:00:15 out   ),
18:00:15 out   );
18:00:15 out   painter.rect_filled(fill, 0.0, GOLD_DARK);
18:00:15 out   painter.rect_filled(
18:00:15 out   Rect::from_min_size(fill.min, Vec2::new(fill.width(), 2.0)),
18:00:15 out   0.0,
18:00:15 out   GOLD,
18:00:15 out   );
18:00:15 out   let knob_x = track.left() + 2.0 + (track.width() - 4.0) * value.clamp(0.0, 1.0);
18:00:15 out   let knob = Rect::from_center_size(Pos2::new(knob_x, rect.center().y), Vec2::new(10.0, 22.0));
18:00:15 out   painter.rect_filled(knob, 0.0, BUTTON_HOVER);
18:00:15 out   painter.rect_stroke(knob, 0.0, Stroke::new(1.0_f32, OUTLINE));
18:00:15 out   paint_bevel(painter, knob.shrink(1.0), 1.0);
18:00:15 out   (response, changed)
18:00:15 out   }
18:00:15 out   pub fn progress_bar(ui: &mut Ui, ratio: f32, width: f32) -> (Response, Option<f32>) {
18:00:15 out   let (rect, response) = ui.allocate_exact_size(Vec2::new(width, 18.0), Sense::click_and_drag());
18:00:15 out   let mut seek = None;
18:00:15 out   if response.clicked() || response.dragged() {
18:00:15 out   if let Some(pos) = ui.ctx().pointer_interact_pos() {
18:00:15 out   seek = Some(((pos.x - rect.left()) / rect.width().max(1.0)).clamp(0.0, 1.0));
18:00:15 out   }
18:00:15 out   }
18:00:15 out   let painter = ui.painter();
18:00:15 out   painter.rect_filled(rect, 0.0, PANEL_DEEP);
18:00:15 out   painter.rect_stroke(rect, 0.0, Stroke::new(1.0_f32, OUTLINE));
18:00:15 out   let inner = rect.shrink(3.0);
18:00:15 out   let fill_w = inner.width() * ratio.clamp(0.0, 1.0);
18:00:15 out   let fill = Rect::from_min_size(inner.min, Vec2::new(fill_w, inner.height()));
18:00:15 out   painter.rect_filled(fill, 0.0, Color32::from_rgb(86, 150, 70));
18:00:15 out   painter.rect_filled(
18:00:15 out   Rect::from_min_size(fill.min, Vec2::new(fill.width(), 2.0)),
18:00:15 out   0.0,
18:00:15 out   Color32::from_rgb(150, 225, 120),
18:00:15 out   ---TEXTURES---
18:00:15 out   //! Procedural pixel art, generated at startup.
18:00:15 out   //!
18:00:15 out   //! Every texture is uploaded with nearest-neighbour filtering and no mipmaps,
18:00:15 out   //! so it stays chunky at any window size. If the user drops a real PNG into
18:00:15 out   //! `assets/` we use it instead, otherwise the art below is original.
18:00:15 out   use eframe::egui::{self, Color32, ColorImage, TextureHandle, TextureOptions};
18:00:15 out   use std::path::Path;
18:00:15 out   use crate::disc::{Disc, Pattern, DISCS};
18:00:15 out   pub struct Textures {
18:00:15 out   pub background: TextureHandle,
18:00:15 out   pub wood: TextureHandle,
18:00:15 out   pub jukebox: TextureHandle,
18:00:15 out   pub discs: Vec<TextureHandle>,
18:00:15 out   }
18:00:15 out   impl Textures {
18:00:15 out   pub fn new(ctx: &egui::Context) -> Self {
18:00:15 out   let background = load_optional_png("dirt.png").unwrap_or_else(make_dirt_texture);
18:00:15 out   let wood = load_optional_png("wood.png").unwrap_or_else(make_wood_texture);
18:00:15 out   let jukebox = load_optional_png("jukebox.png").unwrap_or_else(make_jukebox_texture);
18:00:15 out   let repeat = TextureOptions {
18:00:15 out   magnification: egui::TextureFilter::Nearest,
18:00:15 out   minification: egui::TextureFilter::Nearest,
18:00:15 out   wrap_mode: egui::TextureWrapMode::Repeat,
18:00:15 out   mipmap_mode: None,
18:00:15 out   };
18:00:15 out   let nearest = TextureOptions::NEAREST;
18:00:15 out   let discs = DISCS
18:00:15 out   .iter()
18:00:15 out   .map(|disc| {
18:00:15 out   ctx.load_texture(
18:00:15 out   format!("disc-{}", disc.id),
18:00:15 out   make_disc_texture(disc),
18:00:15 out   nearest,
18:00:15 out   )
18:00:15 out   })
18:00:15 out   .collect();
18:00:15 out   Self {
18:00:15 out   background: ctx.load_texture("dirt-tile", background, repeat),
18:00:15 out   wood: ctx.load_texture("wood-tile", wood, repeat),
18:00:15 out   jukebox: ctx.load_texture("jukebox", jukebox, nearest),
18:00:15 out   discs,
18:00:15 out   }
18:00:15 out   }
18:00:15 out   }
18:00:15 out   fn load_optional_png(name: &str) -> Option<ColorImage> {
18:00:15 out   let path = Path::new(env!("CARGO_MANIFEST_DIR"))
18:00:15 out   .join("assets")
18:00:15 out   .join(name);
18:00:15 out   if !path.is_file() {
18:00:15 out   return None;
18:00:15 out   }
18:00:15 out   let img = image::open(path).ok()?.to_rgba8();
18:00:15 out   let size = [img.width() as usize, img.height() as usize];
18:00:15 out   Some(ColorImage::from_rgba_unmultiplied(size, img.as_raw()))
18:00:15 out   }
18:00:15 out   fn hash(x: u32, y: u32, seed: u32) -> u32 {
18:00:15 out   let mut h = x
18:00:15 out   .wrapping_mul(374_761_393)
18:00:15 out   .wrapping_add(y.wrapping_mul(668_265_263))
18:00:15 out   .wrapping_add(seed.wrapping_mul(69069));
18:00:15 out   h = (h ^ (h >> 13)).wrapping_mul(1_274_126_177);
18:00:15 out   h ^ (h >> 16)
18:00:15 out   }
18:00:15 out   fn rgb(r: u8, g: u8, b: u8) -> Color32 {
18:00:15 out   Color32::from_rgb(r, g, b)
18:00:15 out   }
18:00:15 out   fn scale(c: (u8, u8, u8), f: f32) -> Color32 {
18:00:15 out   rgb(
18:00:15 out   (c.0 as f32 * f).clamp(0.0, 255.0) as u8,
18:00:15 out   (c.1 as f32 * f).clamp(0.0, 255.0) as u8,
18:00:15 out   (c.2 as f32 * f).clamp(0.0, 255.0) as u8,
18:00:15 out   )
18:00:15 out   }
18:00:15 out   fn make_dirt_texture() -> ColorImage {
18:00:15 out   const W: usize = 16;
18:00:15 out   const H: usize = 16;
18:00:15 out   let palette = [
18:00:15 out   (61, 42, 28),
18:00:15 out   (74, 51, 34),
18:00:15 out   (84, 59, 39),
18:00:15 out   (53, 36, 25),
18:00:15 out   (68, 47, 31),
18:00:15 out   ];
18:00:15 out   let mut pixels = Vec::with_capacity(W * H);
18:00:15 out   for y in 0..H {
18:00:15 out   for x in 0..W {
18:00:15 out   let n = hash(x as u32, y as u32, 7);
18:00:15 out   let mut c = palette[(n as usize) % palette.len()];
18:00:15 out   if n.is_multiple_of(19) {
18:00:15 out   c = (44, 30, 22);
18:00:15 out   } else if n.is_multiple_of(29) {
18:00:15 out   c = (104, 77, 52);
18:00:15 out   } else if n.is_multiple_of(41) {
18:00:15 out   c = (36, 25, 20);
18:00:15 out   }
18:00:15 out   // a few tiny stone/pebble flecks
18:00:15 out   if n.is_multiple_of(53) {
18:00:15 out   c = (92, 88, 80);
18:00:15 out   }
18:00:15 out   pixels.push(rgb(c.0, c.1, c.2));
18:00:15 out   }
18:00:15 out   }
18:00:15 out   ColorImage {
18:00:15 out   size: [W, H],
18:00:15 out   pixels,
18:00:15 out   }
18:00:15 out   }
18:00:15 out   fn make_wood_texture() -> ColorImage {
18:00:15 out   const W: usize = 32;
18:00:15 out   const H: usize = 16;
18:00:15 out   let mut pixels = Vec::with_capacity(W * H);
18:00:15 out   for y in 0..H {
18:00:15 out   let plank = y / 4;
18:00:15 out   let base = 54 + (hash(0, plank as u32, 3) % 14) as u8;
18:00:15 out   for x in 0..W {
18:00:15 out   let n = hash(x as u32, y as u32, 11);
18:00:15 out   let mut c = rgb(base + 34, base + 18, base);
18:00:15 out   if y % 4 == 3 {
18:00:15 out   c = rgb(
18:00:15 out   base.saturating_sub(8),
18:00:15 out   base.saturating_sub(12),
18:00:15 out   base.saturating_sub(14),
18:00:15 out   );
18:00:15 out   } else if n.is_multiple_of(13) {
18:00:15 out   c = rgb(base + 42, base + 24, base + 4);
18:00:15 out   } else if n.is_multiple_of(17) {
18:00:15 out   c = rgb(base + 20, base + 10, base.saturating_sub(4));
18:00:15 out   }
18:00:15 out   pixels.push(c);
18:00:15 out   }
18:00:15 out   }
18:00:15 out   ColorImage {
18:00:15 out   size: [W, H],
18:00:15 out   pixels,
18:00:15 out   }
18:00:15 out   }
18:00:15 out   fn make_jukebox_texture() -> ColorImage {
18:00:15 out   const W: usize = 64;
18:00:15 out   const H: usize = 64;
18:00:15 out   let mut pixels = vec![Color32::TRANSPARENT; W * H];
18:00:15 out   let mut put = |x: usize, y: usize, c: Color32| {
18:00:15 out   if x < W && y < H {
18:00:15 out   pixels[y * W + x] = c;
18:00:15 out   }
18:00:15 out   };
18:00:15 out   for y in 0..H {
18:00:15 out   for x in 0..W {
18:00:15 out   let edge = x < 2 || y < 2 || x >= W - 2 || y >= H - 2;
18:00:15 out   let mut c = if edge {
18:00:15 out   rgb(18, 12, 10)
18:00:15 out   } else {
18:00:15 out   let n = hash(x as u32, y as u32, 23);
18:00:15 out   let plank = y / 8;
18:00:15 out   let base = 82 + (hash(0, plank as u32, 5) % 12) as u8;
18:00:15 out   let mut c = rgb(base + 36, base + 18, base.saturating_sub(2));
18:00:15 out   if y.is_multiple_of(8) {
18:00:15 out   c = rgb(base + 12, base + 4, base.saturating_sub(14));
18:00:15 out   } else if n.is_multiple_of(17) {
18:00:15 out   c = rgb(base + 48, base + 28, base + 6);
18:00:15 out   } else if n.is_multiple_of(29) {
18:00:15 out   c = rgb(base + 18, base + 6, base.saturating_sub(8));
18:00:15 out   }
18:00:15 out   c
18:00:15 out   };
18:00:15 out   // outer frame highlight / shadow
18:00:15 out   if x == 2 || y == 2 {
18:00:15 out   c = rgb(128, 84, 48);
18:00:15 out   }
18:00:15 out   if x == W - 3 || y == H - 3 {
18:00:15 out   c = rgb(52, 32, 22);
18:00:15 out   }
18:00:15 out   put(x, y, c);
18:00:15 out   }
18:00:15 out   }
18:00:15 out   // dark top slot
18:00:15 out   for y in 7..18 {
18:00:15 out   for x in 16..48 {
18:00:15 out   let mut c = rgb(14, 11, 10);
18:00:15 out   if y == 7 || y == 17 || x == 16 || x == 47 {
18:00:15 out   c = rgb(5, 5, 6);
18:00:15 out   } else if y == 8 {
18:00:15 out   c = rgb(74, 52, 34);
18:00:15 out   }
18:00:15 out   put(x, y, c);
18:00:15 out   }
18:00:15 out   }
18:00:15 out   for y in 10..15 {
18:00:15 out   for x in 20..44 {
18:00:15 out   put(x, y, rgb(4, 4, 5));
18:00:15 out   }
18:00:15 out   }
18:00:15 out   // front inset panel
18:00:15 out   for y in 27..55 {
18:00:15 out   for x in 10..54 {
18:00:15 out   let border = x == 10 || x == 53 || y == 27 || y == 54;
18:00:15 out   let mut c = if border {
18:00:15 out   rgb(48, 30, 20)
18:00:15 out   } else {
18:00:15 out   rgb(31, 21, 17)
18:00:15 out   };
18:00:15 out   if y == 28 && x > 10 && x < 53 {
18:00:15 out   c = rgb(76, 51, 32);
18:00:15 out   }
18:00:15 out   put(x, y, c);
18:00:15 out   }
18:00:15 out   }
18:00:15 out   // gold trim around the front panel
18:00:15 out   for x in 12..52 {
18:00:15 out   put(x, 29, rgb(150, 104, 44));
18:00:15 out   put(x, 52, rgb(92, 60, 28));
18:00:15 out   }
18:00:15 out   for y in 29..53 {
18:00:15 out   put(12, y, rgb(150, 104, 44));
18:00:15 out   put(51, y, rgb(92, 60, 28));
18:00:15 out   }
18:00:15 out   // pixel music note on the front
18:00:15 out   let note = rgb(255, 205, 82);
18:00:15 out   let note_dark = rgb(184, 126, 36);
18:00:15 out   for y in 36..46 {
18:00:15 out   put(30, y, note);
18:00:15 out   put(31, y, note);
18:00:15 out   }
18:00:15 out   for x in 30..39 {
18:00:15 out   put(x, 36, note);
18:00:15 out   put(x, 37, note_dark);
18:00:15 out   }
18:00:15 out   for x in 35..40 {
18:00:15 out   put(x, 38, note);
18:00:15 out   put(x, 39, note_dark);
18:00:15 out   }
18:00:15 out   for y in 43..49 {
18:00:15 out   for x in 25..33 {
18:00:15 out   let d = (x as i32 - 29).abs() + (y as i32 - 46).abs();
18:00:15 out   if d < 4 {
18:00:15 out   put(x, y, if d < 2 { note } else { note_dark });
18:00:15 out   }
18:00:15 out   }
18:00:15 out   }
18:00:15 out   // corner bolts
18:00:15 out   for (bx, by) in [(5, 5), (58, 5), (5, 58), (58, 58)] {
18:00:15 out   for y in by..by + 3 {
18:00:15 out   for x in bx..bx + 3 {
18:00:15 out   put(x, y, rgb(116, 112, 100));
18:00:15 out   }
18:00:15 out   }
18:00:15 out   put(bx + 1, by + 1, rgb(46, 44, 40));
18:00:15 out   }
18:00:15 out   ColorImage {
18:00:15 out   size: [W, H],
18:00:15 out   pixels,
18:00:15 out   }
18:00:15 out   }
18:00:15 out   fn make_disc_texture(disc: &Disc) -> ColorImage {
18:00:15 out   const W: usize = 32;
18:00:15 out   const H: usize = 32;
18:00:15 out   let mut pixels = vec![Color32::TRANSPARENT; W * H];
18:00:15 out   let cx = 15.5_f32;
18:00:15 out   let cy = 15.5_f32;
18:00:15 out   for y in 0..H {
18:00:15 out   for x in 0..W {
18:00:15 out   let dx = x as f32 - cx;
18:00:15 out   let dy = y as f32 - cy;
18:00:15 out   let d = (dx * dx + dy * dy).sqrt();
18:00:15 out   if d > 15.3 {
18:00:15 out   continue;
18:00:15 out   }
18:00:15 out   let mut c = scale(disc.color, 1.0);
18:00:15 out   if d > 14.2 {
18:00:15 out   c = scale(disc.color, 0.55);
18:00:15 out   } else if d > 12.8 {
18:00:15 out   c = scale(disc.accent, 0.8);
18:00:15 out   } else if d > 5.4 {
18:00:15 out   // vinyl grooves
18:00:15 out   let ring = d as i32;
18:00:15 out   if ring % 2 == 0 {
18:00:15 out   c = scale(disc.color, 0.76);
18:00:15 out   }
18:00:15 out   if ring % 5 == 0 {
18:00:15 out   c = scale(disc.color, 1.18);
18:00:15 out   }
18:00:15 out   if pattern_pixel(disc.pattern, x, y) {
18:00:15 out   c = scale(disc.accent, 0.92);
18:00:15 out   }
18:00:15 out   } else if d > 1.6 {
18:00:15 out   c = scale(disc.accent, 1.0);
18:00:15 out   if d > 4.6 {
18:00:15 out   c = scale(disc.accent, 0.7);
18:00:15 out   }
18:00:15 out   } else {
18:00:15 out   c = rgb(12, 10, 12);
18:00:15 out   }
18:00:15 out   // a chunky highlight on the upper-left
18:00:15 out   if (x == 9 && (y == 10 || y == 11)) || (x == 10 && y == 9) {
18:00:15 out   c = rgb(238, 238, 230);
18:00:15 out   }
18:00:15 out   pixels[y * W + x] = c;
18:00:15 out   }
18:00:15 out   }
18:00:15 out   ColorImage {
18:00:15 out   size: [W, H],
18:00:15 out   pixels,
18:00:15 out   }
18:00:15 out   }
18:00:15 out   fn pattern_pixel(pattern: Pattern, x: usize, y: usize) -> bool {
18:00:15 out   let x = x as i32;
18:00:15 out   let y = y as i32;
18:00:15 out   match pattern {
18:00:15 out   Pattern::Ring => {
18:00:15 out   let dx = x - 16;
18:00:15 out   let dy = y - 16;
18:00:15 out   let d2 = dx * dx + dy * dy;
18:00:15 out   (64..=81).contains(&d2)
18:00:15 out   }
18:00:15 out   Pattern::Stripe => (x + y) % 8 == 0 || (x - y).rem_euclid(8) == 0,
18:00:15 out   Pattern::Cross => x == 16 || y == 16,
18:00:15 out   Pattern::Diamond => {
18:00:15 out   let d = (x - 16).abs() + (y - 16).abs();
18:00:15 out   d == 8 || d == 9
18:00:15 out   }
18:00:15 out   Pattern::Dots => x % 6 == 0 && y % 6 == 0,
18:00:15 out   Pattern::Star => {
18:00:15 out   let dx = (x - 16).abs();
18:00:15 out   let dy = (y - 16).abs();
18:00:15 out   (dx <= 1 && (6..=11).contains(&dy)) || (dy <= 1 && (6..=11).contains(&dx))
18:00:15 out   }
18:00:15 out   Pattern::Wave => {
18:00:15 out   let target = 16 + ((x as f32 * 0.75).sin() * 4.0) as i32;
18:00:15 out   (y - target).abs() <= 1
18:00:15 out   }
18:00:15 out   Pattern::Split => (x > 16 && y > 16) || (x < 15 && y < 15),
18:00:15 out   }
18:00:15 out   }
18:00:15 out   ---SELFTEST---
18:00:15 out   //! Headless self-test used by Craft Anything.
18:00:15 out   //!
18:00:15 out   //! It drives the same state machine and renders the same egui UI as the real
18:00:15 out   //! app, then measures the result from the app's own fields and paint output.
18:00:15 out   use crate::app::{JukeboxApp, JukeboxState, Startup, WINDOW_H, WINDOW_W};
18:00:15 out   use crate::disc::DISCS;
18:00:15 out   use crate::player::Player;
18:00:15 out   use eframe::egui::{self, Event, Key, Modifiers, Pos2, RawInput, Rect, Vec2};
18:00:15 out   use serde_json::json;
18:00:15 out   use std::path::PathBuf;
18:00:15 out   pub fn run(path: PathBuf) -> bool {
18:00:15 out   let ctx = egui::Context::default();
18:00:15 out   let startup = Startup {
18:00:15 out   screenshot: None,
18:00:15 out   self_test: Some(path.clone()),
18:00:15 out   };
18:00:15 out   let mut app = JukeboxApp::new_with_ctx(&ctx, startup);
18:00:15 out   // The self-test is about the UI/state machine, not about the user's music
18:00:15 out   // collection, so it uses the silent demo timer.
18:00:15 out   app.setup_open = false;
18:00:15 out   app.library = None;
18:00:15 out   app.library_error = None;
18:00:15 out   app.player = Player::simulated();
18:00:15 out   app.demo_mode = true;
18:00:15 out   app.repeat = false;
18:00:15 out   app.config.repeat = false;
18:00:15 out   let screen = Rect::from_min_size(Pos2::ZERO, Vec2::new(WINDOW_W, WINDOW_H));
18:00:15 out   // --- move: arrow key changes the selected disc ---------------------
18:00:15 out   let before = app.selected;
18:00:15 out   let raw = RawInput {
18:00:15 out   screen_rect: Some(screen),
18:00:15 out   events: vec![Event::Key {
18:00:15 out   key: Key::ArrowRight,
18:00:15 out   physical_key: Some(Key::ArrowRight),
18:00:15 out   pressed: true,
18:00:15 out   repeat: false,
18:00:15 out   modifiers: Modifiers::NONE,
18:00:15 out   }],
18:00:15 out   ..Default::default()
18:00:15 out   };
18:00:15 out   let _ = ctx.run(raw, |ctx| app.handle_input(ctx));
18:00:15 out   let moved = app.selected != before;
18:00:15 out   let move_detail = if moved {
18:00:15 out   format!(
18:00:15 out   "arrow key moved selection from {} to {}",
18:00:15 out   DISCS[before].title, DISCS[app.selected].title
18:00:15 out   )
18:00:15 out   } else {
18:00:15 out   "arrow key did not change the selected disc".to_string()
18:00:15 out   };
18:00:15 out   // --- act: space inserts the disc and playback advances -------------
18:00:15 out   let raw = RawInput {
18:00:15 out   screen_rect: Some(screen),
18:00:15 out   events: vec![Event::Key {
18:00:15 out   key: Key::Space,
18:00:15 out   physical_key: Some(Key::Space),
18:00:15 out   pressed: true,
18:00:15 out   repeat: false,
18:00:15 out   modifiers: Modifiers::NONE,
18:00:15 out   }],
18:00:15 out   ..Default::default()
18:00:15 out   };
18:00:15 out   let _ = ctx.run(raw, |ctx| app.handle_input(ctx));
18:00:15 out   for _ in 0..5 {
18:00:15 out   app.advance(0.1);
18:00:15 out   }
18:00:15 out   for _ in 0..20 {
18:00:15 out   app.advance(0.1);
18:00:15 out   }
18:00:15 out   let elapsed = app.player.elapsed().as_secs_f32();
18:00:15 out   let act_ok = app.state == JukeboxState::Playing && elapsed >= 1.5;
18:00:15 out   let act_detail = if act_ok {
18:00:15 out   format!(
18:00:15 out   "inserted {}; playback timer advanced {:.1} s",
18:00:15 out   app.inserted.map(|i| DISCS[i].title).unwrap_or("disc"),
18:00:15 out   elapsed
18:00:15 out   )
18:00:15 out   } else {
18:00:15 out   format!(
18:00:15 out   "state {:?}, playback timer {:.2} s (expected Playing and > 1.5 s)",
18:00:15 out   app.state, elapsed
18:00:15 out   )
18:00:15 out   };
18:00:15 out   // --- hud: render a real frame and look for the on-screen text ------
18:00:15 out   let raw = RawInput {
18:00:15 out   screen_rect: Some(screen),
18:00:15 out   ..Default::default()
18:00:15 out   };
18:00:15 out   let output = ctx.run(raw, |ctx| app.render(ctx));
18:00:15 out   let has_now_playing = output
18:00:15 out   .shapes
18:00:15 out   .iter()
18:00:15 out   .any(|s| shape_has_text(&s.shape, "NOW PLAYING"));
18:00:15 out   let has_track = output
18:00:15 out   .shapes
18:00:15 out   .iter()
18:00:15 out   .any(|s| shape_has_text(&s.shape, "C418 - Cat"));
18:00:15 out   let has_controls = output
18:00:15 out   .shapes
18:00:15 out   .iter()
18:00:15 out   .any(|s| shape_has_text(&s.shape, "REPEAT"))
18:00:15 out   && output
18:00:15 out   .shapes
18:00:15 out   .iter()
18:00:15 out   .any(|s| shape_has_text(&s.shape, "VOL"));
18:00:15 out   let hud_ok = has_now_playing && has_track && has_controls;
18:00:15 out   let hud_detail = if hud_ok {
18:00:15 out   "now-playing line, progress controls and repeat/volume controls were drawn".to_string()
18:00:15 out   } else {
18:00:15 out   format!(
18:00:15 out   "drawn text check: now_playing={has_now_playing}, track={has_track}, controls={has_controls}"
18:00:15 out   )
18:00:15 out   };
18:00:15 out   let all_ok = moved && act_ok && hud_ok;
18:00:15 out   let result = json!({
18:00:15 out   "version": 1,
18:00:15 out   "steps": [
18:00:15 out   {"step": "move", "passed": moved, "detail": move_detail},
18:00:15 out   {"step": "act", "passed": act_ok, "detail": act_detail},
18:00:15 out   {"step": "hud", "passed": hud_ok, "detail": hud_detail}
18:00:15 out   ]
18:00:15 out   });
18:00:15 out   if let Some(parent) = path.parent() {
18:00:15 out   if let Err(err) = std::fs::create_dir_all(parent) {
18:00:15 out   eprintln!("Could not create self-test folder: {err}");
18:00:15 out   return false;
18:00:15 out   }
18:00:15 out   }
18:00:15 out   match std::fs::write(
18:00:15 out   &path,
18:00:15 out   serde_json::to_vec_pretty(&result).unwrap_or_default(),
18:00:15 out   ) {
18:00:15 out   Ok(()) => {
18:00:15 out   eprintln!(
18:00:15 out   "Self-test written to {} ({})",
18:00:15 out   path.display(),
18:00:15 out   if all_ok { "all steps passed" } else { "FAILED" }
18:00:15 out   );
18:00:15 out   all_ok
18:00:15 out   }
18:00:15 out   Err(err) => {
18:00:15 out   eprintln!("Could not write self-test: {err}");
18:00:15 out   false
18:00:15 out   }
18:00:15 out   }
18:00:15 out   }
18:00:15 out   fn shape_has_text(shape: &egui::Shape, needle: &str) -> bool {
18:00:15 out   match shape {
18:00:15 out   egui::Shape::Text(text) => text.galley.text().contains(needle),
18:00:15 out   egui::Shape::Vec(shapes) => shapes.iter().any(|s| shape_has_text(s, needle)),
18:00:15 out   _ => false,
18:00:15 out   }
18:00:15 out   }
