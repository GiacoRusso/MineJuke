18:00:15 out   //! Audio playback on a dedicated rodio sink.
18:00:15 out   //!
18:00:15 out   //! The UI never waits for audio: playback happens on cpal's audio thread and
18:00:15 out   //! the app only reads the sink position. If there is no audio device (or the
18:00:15 out   //! user asks for a screenshot/self-test), the same timer is driven in software
18:00:15 out   //! so the interface remains testable and never freezes.
18:00:15 out   use anyhow::{Context, Result};
18:00:15 out   use rodio::{Decoder, OutputStream, OutputStreamHandle, Sink, Source};
18:00:15 out   use std::fs::File;
18:00:15 out   use std::io::BufReader;
18:00:15 out   use std::path::Path;
18:00:15 out   use std::time::Duration;
18:00:15 out   pub struct Player {
18:00:15 out   /// Kept alive for as long as playback: dropping it closes the audio device.
18:00:15 out   #[allow(dead_code)]
18:00:15 out   stream: Option<OutputStream>,
18:00:15 out   handle: Option<OutputStreamHandle>,
18:00:15 out   sink: Option<Sink>,
18:00:15 out   volume: f32,
18:00:15 out   duration: Option<Duration>,
18:00:15 out   started: bool,
18:00:15 out   simulated: bool,
18:00:15 out   sim_elapsed: Duration,
18:00:15 out   sim_duration: Duration,
18:00:15 out   pub audio_error: Option<String>,
18:00:15 out   }
18:00:15 out   /// Accurate duration for an Ogg Vorbis file.
18:00:15 out   ///
18:00:15 out   /// The decoder's `total_duration` is unreliable for Ogg (lewton reports none,
18:00:15 out   /// and rodio 0.20's symphonia path miscalculates the fractional part), so read
18:00:15 out   /// the last granule position from the Ogg pages and divide by the sample rate.
18:00:15 out   fn probe_duration(path: &Path, decoder: &Decoder<BufReader<File>>) -> Option<Duration> {
18:00:15 out   let sample_rate = decoder.sample_rate();
18:00:15 out   ogg_granule_duration(path, sample_rate).or_else(|| decoder.total_duration())
18:00:15 out   }
18:00:15 out   fn ogg_granule_duration(path: &Path, sample_rate: u32) -> Option<Duration> {
18:00:15 out   if sample_rate == 0 {
18:00:15 out   return None;
18:00:15 out   }
18:00:15 out   let bytes = std::fs::read(path).ok()?;
18:00:15 out   let mut offset = 0usize;
18:00:15 out   let mut last_granule: Option<u64> = None;
18:00:15 out   while offset + 27 <= bytes.len() {
18:00:15 out   if &bytes[offset..offset + 4] != b"OggS" {
18:00:15 out   break;
18:00:15 out   }
18:00:15 out   let granule = i64::from_le_bytes(bytes[offset + 6..offset + 14].try_into().ok()?);
18:00:15 out   let segments = bytes[offset + 26] as usize;
18:00:15 out   let table_end = offset + 27 + segments;
18:00:15 out   if table_end > bytes.len() {
18:00:15 out   break;
18:00:15 out   }
18:00:15 out   let data_len: usize = bytes[offset + 27..table_end]
18:00:15 out   .iter()
18:00:15 out   .map(|count| *count as usize)
18:00:15 out   .sum();
18:00:15 out   let next = table_end + data_len;
18:00:15 out   if next > bytes.len() {
18:00:15 out   break;
18:00:15 out   }
18:00:15 out   if granule >= 0 {
18:00:15 out   last_granule = Some(granule as u64);
18:00:15 out   }
18:00:15 out   offset = next;
18:00:15 out   }
18:00:15 out   let samples = last_granule?;
18:00:15 out   Some(Duration::from_secs_f64(samples as f64 / sample_rate as f64))
18:00:15 out   }
18:00:15 out   impl Player {
18:00:15 out   pub fn new() -> Self {
18:00:15 out   match OutputStream::try_default() {
18:00:15 out   Ok((stream, handle)) => Self {
18:00:15 out   stream: Some(stream),
18:00:15 out   handle: Some(handle),
18:00:15 out   sink: None,
18:00:15 out   volume: 0.7,
18:00:15 out   duration: None,
18:00:15 out   started: false,
18:00:15 out   simulated: false,
18:00:15 out   sim_elapsed: Duration::ZERO,
18:00:15 out   sim_duration: Duration::ZERO,
18:00:15 out   audio_error: None,
18:00:15 out   },
18:00:15 out   Err(err) => Self {
18:00:15 out   stream: None,
18:00:15 out   handle: None,
18:00:15 out   sink: None,
18:00:15 out   volume: 0.7,
18:00:15 out   duration: None,
18:00:15 out   started: false,
18:00:15 out   simulated: true,
18:00:15 out   sim_elapsed: Duration::ZERO,
18:00:15 out   sim_duration: Duration::ZERO,
18:00:15 out   audio_error: Some(format!("No audio output device: {err}")),
18:00:15 out   },
18:00:15 out   }
18:00:15 out   }
18:00:15 out   /// Used by the screenshot and self-test modes: no sound, real state machine.
18:00:15 out   pub fn simulated() -> Self {
18:00:15 out   Self {
18:00:15 out   stream: None,
18:00:15 out   handle: None,
18:00:15 out   sink: None,
18:00:15 out   volume: 0.7,
18:00:15 out   duration: None,
18:00:15 out   started: false,
18:00:15 out   simulated: true,
18:00:15 out   sim_elapsed: Duration::ZERO,
18:00:15 out   sim_duration: Duration::ZERO,
18:00:15 out   audio_error: None,
18:00:15 out   }
18:00:15 out   }
18:00:15 out   pub fn set_volume(&mut self, volume: f32) {
18:00:15 out   self.volume = volume.clamp(0.0, 1.0);
18:00:15 out   if let Some(sink) = &self.sink {
18:00:15 out   sink.set_volume(self.volume);
18:00:15 out   }
18:00:15 out   }
18:00:15 out   /// Start a real Ogg Vorbis file. Falls back to a silent software timer if
18:00:15 out   /// an output device cannot be opened, so the UI still behaves correctly.
18:00:15 out   pub fn play(&mut self, path: &Path) -> Result<Duration> {
18:00:15 out   self.stop();
18:00:15 out   let file =
18:00:15 out   File::open(path).with_context(|| format!("Could not open {}", path.display()))?;
18:00:15 out   let decoder = Decoder::new(BufReader::new(file))
18:00:15 out   .with_context(|| format!("Could not decode Ogg Vorbis {}", path.display()))?;
18:00:15 out   let duration = probe_duration(path, &decoder).unwrap_or_else(|| Duration::from_secs(180));
18:00:15 out   let mut sink_ok = false;
18:00:15 out   if let Some(handle) = &self.handle {
18:00:15 out   match Sink::try_new(handle) {
18:00:15 out   Ok(sink) => {
18:00:15 out   sink.set_volume(self.volume);
18:00:15 out   sink.append(decoder);
18:00:15 out   self.sink = Some(sink);
18:00:15 out   sink_ok = true;
18:00:15 out   }
18:00:15 out   Err(err) => {
18:00:15 out   self.audio_error = Some(format!("Could not start audio: {err}"));
18:00:15 out   }
18:00:15 out   }
18:00:15 out   }
18:00:15 out   self.duration = Some(duration);
18:00:15 out   self.started = true;
18:00:15 out   self.simulated = !sink_ok;
18:00:15 out   self.sim_elapsed = Duration::ZERO;
18:00:15 out   self.sim_duration = duration;
18:00:15 out   Ok(duration)
18:00:15 out   }
18:00:15 out   pub fn play_simulated(&mut self, duration: Duration) {
18:00:15 out   self.stop();
18:00:15 out   self.duration = Some(duration);
18:00:15 out   self.started = true;
18:00:15 out   self.simulated = true;
18:00:15 out   self.sim_elapsed = Duration::ZERO;
18:00:15 out   self.sim_duration = duration;
18:00:15 out   }
18:00:15 out   pub fn stop(&mut self) {
18:00:15 out   if let Some(sink) = self.sink.take() {
18:00:15 out   sink.stop();
18:00:15 out   }
18:00:15 out   self.started = false;
18:00:15 out   self.simulated = false;
18:00:15 out   self.sim_elapsed = Duration::ZERO;
18:00:15 out   self.duration = None;
18:00:15 out   }
18:00:15 out   pub fn advance(&mut self, dt: Duration) {
18:00:15 out   if self.started && self.simulated && !self.is_finished() {
18:00:15 out   self.sim_elapsed = (self.sim_elapsed + dt).min(self.sim_duration);
18:00:15 out   }
18:00:15 out   }
18:00:15 out   pub fn elapsed(&self) -> Duration {
18:00:15 out   if self.started && !self.simulated {
18:00:15 out   if let Some(sink) = &self.sink {
18:00:15 out   return sink.get_pos();
18:00:15 out   }
18:00:15 out   }
18:00:15 out   self.sim_elapsed
18:00:15 out   }
18:00:15 out   pub fn duration(&self) -> Option<Duration> {
18:00:15 out   self.duration
18:00:15 out   }
18:00:15 out   pub fn is_finished(&self) -> bool {
18:00:15 out   if !self.started {
18:00:15 out   return false;
18:00:15 out   }
18:00:15 out   if self.simulated {
18:00:15 out   self.sim_elapsed >= self.sim_duration && self.sim_duration > Duration::ZERO
18:00:15 out   } else if let Some(sink) = &self.sink {
18:00:15 out   // A sink can be momentarily empty while the queue starts. The app
18:00:15 out   // only polls this while Playing, after the insert animation.
18:00:15 out   sink.empty()
18:00:15 out   } else {
18:00:15 out   true
18:00:15 out   }
18:00:15 out   }
18:00:15 out   pub fn seek(&mut self, position: Duration) {
18:00:15 out   let duration = self.duration.unwrap_or(position);
18:00:15 out   let clamped = position.min(duration);
18:00:15 out   if self.simulated {
18:00:15 out   self.sim_elapsed = clamped;
18:00:15 out   } else if let Some(sink) = &self.sink {
18:00:15 out   let _ = sink.try_seek(clamped);
18:00:15 out   }
18:00:15 out   }
18:00:15 out   }
