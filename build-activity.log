20:05:36 out   .unwrap_or(0.0);
20:05:36 out   let ratio = if duration > 0.0 {
20:05:36 out   (elapsed / duration).clamp(0.0, 1.0)
20:05:36 out   } else {
20:05:36 out   0.0
20:05:36 out   };
20:05:36 out   ui.horizontal(|ui| {
20:05:36 out   ui.add_sized(
20:05:36 out   [46.0, 18.0],
20:05:36 out   Label::new(
20:05:36 out   RichText::new(disc::format_time(elapsed))
20:05:36 out   .size(7.0)
20:05:36 out   .color(MUTED),
20:05:36 out   ),
20:05:36 out   );
20:05:36 out   let bar_w = (ui.available_width() - 104.0).max(100.0);
20:05:36 out   let (_, seek) = style::progress_bar(ui, ratio, bar_w);
20:05:36 out   if let Some(ratio) = seek {
20:05:36 out   self.seek_to(ratio);
20:05:36 out   }
20:05:36 out   ui.add_sized(
20:05:36 out   [46.0, 18.0],
20:05:36 out   Label::new(
20:05:36 out   RichText::new(if duration > 0.0 {
20:05:36 out   disc::format_time(duration)
20:05:36 out   } else {
20:05:36 out   "--:--".to_string()
20:05:36 out   })
20:05:36 out   .size(7.0)
20:05:36 out   .color(MUTED),
20:05:36 out   ),
20:05:36 out   );
20:05:36 out   });
20:05:36 out   ui.add_space(3.0);
20:05:36 out   let controls_w = 100.0 + 8.0 + 110.0 + 12.0 + 30.0 + 8.0 + 150.0 + 8.0 + 44.0;
20:05:36 out   ui.horizontal(|ui| {
20:05:36 out   ui.add_space(((inner_w - controls_w) / 2.0).max(0.0));
20:05:36 out   let can_eject = matches!(
20:05:36 out   self.state,
20:05:36 out   JukeboxState::Inserting | JukeboxState::Playing | JukeboxState::Ejecting
20:05:36 out   );
20:05:36 out   if style::mc_button(ui, "EJECT", Vec2::new(100.0, 32.0), can_eject).clicked() {
20:05:36 out   self.eject();
20:05:36 out   }
20:05:36 out   ui.add_space(8.0);
20:05:36 out   if style::toggle_button(
20:05:36 out   ui,
20:05:36 out   if self.repeat {
20:05:36 out   "REPEAT ON"
20:05:36 out   } else {
20:05:36 out   "REPEAT OFF"
20:05:36 out   },
20:05:36 out   Vec2::new(110.0, 32.0),
20:05:36 out   true,
20:05:36 out   self.repeat,
20:05:36 out   )
20:05:36 out   .clicked()
20:05:36 out   {
20:05:36 out   self.repeat = !self.repeat;
20:05:36 out   self.config.repeat = self.repeat;
20:05:36 out   self.config_dirty = true;
20:05:36 out   }
20:05:36 out   ui.add_space(12.0);
20:05:36 out   style::pixel_label(ui, "VOL", 6.0, MUTED);
20:05:36 out   let (_, changed) = style::slider(ui, &mut self.volume, 150.0);
20:05:36 out   if changed {
20:05:36 out   self.player.set_volume(self.volume);
20:05:36 out   self.config.volume = self.volume;
20:05:36 out   self.config_dirty = true;
20:05:36 out   }
20:05:36 out   style::pixel_label(
20:05:36 out   ui,
20:05:36 out   &format!("{:>3}%", (self.volume * 100.0).round() as i32),
20:05:36 out   6.0,
20:05:36 out   TEXT,
20:05:36 out   );
20:05:36 out   });
20:05:36 out   ui.add_space(3.0);
20:05:36 out   ui.vertical_centered(|ui| {
20:05:36 out   style::pixel_label(
20:05:36 out   ui,
20:05:36 out   "SPACE: PLAY / EJECT < >: CHANGE DISC",
20:05:36 out   6.0,
20:05:36 out   MUTED_DARK,
20:05:36 out   );
20:05:36 out   });
20:05:36 out   });
20:05:36 out   });
20:05:36 out   style::paint_bevel(ui.painter(), outer.response.rect.shrink(2.0), 2.0);
20:05:36 out   ui.painter().rect_stroke(
20:05:36 out   outer.response.rect.shrink(5.0),
20:05:36 out   0.0,
20:05:36 out   Stroke::new(1.0_f32, Color32::from_rgb(50, 54, 62)),
20:05:36 out   );
20:05:36 out   }
20:05:36 out   fn draw_jukebox(&self, painter: &egui::Painter, rect: Rect) {
20:05:36 out   let glow = matches!(self.state, JukeboxState::Inserting | JukeboxState::Playing)
20:05:36 out   && self.inserted.is_some();
20:05:36 out   if glow {
20:05:36 out   for i in 0..4 {
20:05:36 out   let expand = 3.0 + i as f32 * 4.0;
20:05:36 out   painter.rect_filled(
20:05:36 out   rect.expand(expand),
20:05:36 out   8.0,
20:05:36 out   Color32::from_rgba_unmultiplied(255, 205, 90, 12 - i * 2),
20:05:36 out   );
20:05:36 out   }
20:05:36 out   }
20:05:36 out   painter.rect_filled(
20:05:36 out   Rect::from_min_size(rect.min + Vec2::new(8.0, 10.0), rect.size()),
20:05:36 out   0.0,
20:05:36 out   Color32::from_black_alpha(120),
20:05:36 out   );
20:05:36 out   painter.image(
20:05:36 out   self.textures.jukebox.id(),
20:05:36 out   rect,
20:05:36 out   Rect::from_min_max(Pos2::ZERO, Pos2::new(1.0, 1.0)),
20:05:36 out   Color32::WHITE,
20:05:36 out   );
20:05:36 out   let slot = Rect::from_min_max(
20:05:36 out   rect.min + Vec2::new(rect.width() * 0.25, rect.height() * 0.11),
20:05:36 out   rect.min + Vec2::new(rect.width() * 0.75, rect.height() * 0.28),
20:05:36 out   );
20:05:36 out   painter.rect_filled(slot, 0.0, Color32::from_rgba_unmultiplied(0, 0, 0, 130));
20:05:36 out   if let Some(index) = self.inserted {
20:05:36 out   let slot_size = rect.width() * 0.40;
20:05:36 out   let slot_center = Pos2::new(rect.center().x, rect.top() + slot_size * 0.22);
20:05:36 out   let (center, size, alpha, spinning) = match self.state {
20:05:36 out   JukeboxState::Inserting => {
20:05:36 out   let t = ease_out(self.anim_t.clamp(0.0, 1.0));
20:05:36 out   (
20:05:36 out   slot_center + Vec2::new(0.0, (1.0 - t) * rect.height() * INSERT_RISE),
20:05:36 out   slot_size * (0.55 + 0.45 * t),
20:05:36 out   (t * 255.0) as u8,
20:05:36 out   true,
20:05:36 out   )
20:05:36 out   }
20:05:36 out   JukeboxState::Ejecting => {
20:05:36 out   let t = self.anim_t.clamp(0.0, 1.0);
20:05:36 out   (
20:05:36 out   slot_center + Vec2::new(0.0, -t * rect.height() * EJECT_RISE),
20:05:36 out   slot_size * (1.0 - 0.1 * t),
20:05:36 out   ((1.0 - t) * 255.0) as u8,
20:05:36 out   false,
20:05:36 out   )
20:05:36 out   }
20:05:36 out   JukeboxState::Playing => {
20:05:36 out   // While the track plays, the record grows to fill the whole
20:05:36 out   // jukebox block, like a turntable platter seen from above.
20:05:36 out   let bob = (self.anim_time * PLAYING_BOB_SPEED).sin() * PLAYING_BOB_AMP;
20:05:36 out   (rect.center() + Vec2::new(0.0, bob), rect.width(), 255, true)
20:05:36 out   }
20:05:36 out   JukeboxState::Idle => (slot_center, slot_size, 255, false),
20:05:36 out   };
20:05:36 out   let disc_rect = Rect::from_center_size(center, Vec2::splat(size));
20:05:36 out   let tint = Color32::from_white_alpha(alpha);
20:05:36 out   let tex = self.textures.discs[index].id();
20:05:36 out   if spinning {
20:05:36 out   self.paint_spinning_disc(painter, tex, center, size * 0.5, self.spin_angle, tint);
20:05:36 out   } else {
20:05:36 out   painter.image(
20:05:36 out   tex,
20:05:36 out   disc_rect,
20:05:36 out   Rect::from_min_max(Pos2::ZERO, Pos2::new(1.0, 1.0)),
20:05:36 out   tint,
20:05:36 out   );
20:05:36 out   }
20:05:36 out   if matches!(self.state, JukeboxState::Inserting) {
20:05:36 out   let t = self.anim_t.clamp(0.0, 1.0);
20:05:36 out   for i in 0..7 {
20:05:36 out   let angle = i as f32 * 0.9 + self.anim_time * 5.0;
20:05:36 out   let radius = 18.0 + (1.0 - t) * 34.0 + (i % 3) as f32 * 7.0;
20:05:36 out   let p = center + Vec2::new(angle.cos() * radius, angle.sin() * radius * 0.55);
20:05:36 out   painter.rect_filled(
20:05:36 out   Rect::from_center_size(p, Vec2::splat(4.0)),
20:05:36 out   0.0,
20:05:36 out   Color32::from_rgba_unmultiplied(255, 220, 120, (t * 220.0) as u8),
20:05:36 out   );
20:05:36 out   }
20:05:36 out   }
20:05:36 out   }
20:05:36 out   for note in &self.notes {
20:05:36 out   let alpha = ((note.life / note.max_life).clamp(0.0, 1.0) * 255.0) as u8;
20:05:36 out   let color = Color32::from_rgba_unmultiplied(
20:05:36 out   note.color.r(),
20:05:36 out   note.color.g(),
20:05:36 out   note.color.b(),
20:05:36 out   alpha,
20:05:36 out   );
20:05:36 out   style::draw_music_note(painter, Pos2::new(note.x, note.y), 18.0, color, note.kind);
20:05:36 out   }
20:05:36 out   }
20:05:36 out   fn paint_spinning_disc(
20:05:36 out   &self,
20:05:36 out   painter: &egui::Painter,
20:05:36 out   tex: egui::TextureId,
20:05:36 out   center: Pos2,
20:05:36 out   half: f32,
20:05:36 out   angle: f32,
20:05:36 out   tint: Color32,
20:05:36 out   ) {
20:05:36 out   let (s, c) = angle.sin_cos();
20:05:36 out   let rot = |x: f32, y: f32| -> Pos2 {
20:05:36 out   Pos2::new(center.x + x * c - y * s, center.y + x * s + y * c)
20:05:36 out   };
20:05:36 out   let mut mesh = egui::epaint::Mesh::with_texture(tex);
20:05:36 out   mesh.vertices.push(egui::epaint::Vertex {
20:05:36 out   pos: rot(-half, -half),
20:05:36 out   uv: Pos2::new(0.0, 0.0),
20:05:36 out   color: tint,
20:05:36 out   });
20:05:36 out   mesh.vertices.push(egui::epaint::Vertex {
20:05:36 out   pos: rot(half, -half),
20:05:36 out   uv: Pos2::new(1.0, 0.0),
20:05:36 out   color: tint,
20:05:36 out   });
20:05:36 out   mesh.vertices.push(egui::epaint::Vertex {
20:05:36 out   pos: rot(half, half),
20:05:36 out   uv: Pos2::new(1.0, 1.0),
20:05:36 out   color: tint,
20:05:36 out   });
20:05:36 out   mesh.vertices.push(egui::epaint::Vertex {
20:05:36 out   pos: rot(-half, half),
20:05:36 out   uv: Pos2::new(0.0, 1.0),
20:05:36 out   color: tint,
20:05:36 out   });
20:05:36 out   mesh.indices.extend_from_slice(&[0, 1, 2, 0, 2, 3]);
20:05:36 out   painter.add(egui::Shape::mesh(mesh));
20:05:36 out   }
20:05:36 out   fn disc_panel(&mut self, ui: &mut Ui, avail: f32) {
20:05:36 out   let panel_w = avail.clamp(620.0, 1120.0);
20:05:36 out   let frame = egui::Frame::none()
20:05:36 out   .fill(PANEL)
20:05:36 out   .stroke(Stroke::new(2.0_f32, OUTLINE))
20:05:36 out   .inner_margin(Margin::symmetric(14.0, 12.0));
20:05:36 out   let mut clicked_select = None;
20:05:36 out   let mut double_click = None;
20:05:36 out   let mut drag_start = None;
20:05:36 out   let mut drag_update = None;
20:05:36 out   let mut drag_stop = None;
20:05:36 out   let outer = ui.vertical_centered(|ui| {
20:05:36 out   ui.set_max_width(panel_w);
20:05:36 out   frame.show(ui, |ui| {
20:05:36 out   let inner_w = (panel_w - 28.0).max(400.0);
20:05:36 out   ui.set_width(inner_w);
20:05:36 out   ui.horizontal(|ui| {
20:05:36 out   style::pixel_label(ui, "MUSIC DISCS", 10.0, GOLD);
20:05:36 out   ui.with_layout(Layout::right_to_left(Align::Center), |ui| {
20:05:36 out   let ready = self.library.as_ref().map(|l| l.found_count()).unwrap_or(0);
20:05:36 out   style::pixel_label(
20:05:36 out   ui,
20:05:36 out   &format!("{ready} / {} READY", DISCS.len()),
20:05:36 out   6.0,
20:05:36 out   if ready == DISCS.len() { GREEN } else { MUTED },
20:05:36 out   );
20:05:36 out   });
20:05:36 out   });
20:05:36 out   ui.add_space(4.0);
20:05:36 out   // Minecraft inventories use nine columns, but the full 22-disc
20:05:36 out   // catalogue fits in two clean rows at the default window size
20:05:36 out   // when the panel is wide enough. Narrower windows fall back to
20:05:36 out   // the familiar 9 / 6 / 5 / 4 column inventory widths.
20:05:36 out   let cols = if inner_w >= 1000.0 {
20:05:36 out   11
20:05:36 out   } else if inner_w >= 760.0 {
20:05:36 out   9
20:05:36 out   } else if inner_w >= 560.0 {
20:05:36 out   6
20:05:36 out   } else if inner_w >= 460.0 {
20:05:36 out   5
20:05:36 out   } else {
20:05:36 out   4
20:05:36 out   };
20:05:36 out   let gap = 8.0;
20:05:36 out   let card_w = ((inner_w - gap * (cols as f32 - 1.0)) / cols as f32)
20:05:36 out   .floor()
20:05:36 out   .max(80.0);
20:05:36 out   let disc_size = (card_w * 0.46).clamp(38.0, 64.0);
20:05:36 out   // Two title lines are reserved so long names such as
20:05:36 out   // "Creator (Music Box)" never run into a neighbouring card.
20:05:36 out   let card_h = disc_size + 70.0;
20:05:36 out   ui.spacing_mut().item_spacing = Vec2::new(gap, gap);
20:05:36 out   for row in DISCS.chunks(cols) {
20:05:36 out   ui.horizontal(|ui| {
20:05:36 out   for disc in row {
20:05:36 out   let index = DISCS
20:05:36 out   .iter()
20:05:36 out   .position(|d| d.id == disc.id)
20:05:36 out   .unwrap_or_default();
20:05:36 out   let (rect, response) = ui.allocate_exact_size(
20:05:36 out   Vec2::new(card_w, card_h),
20:05:36 out   Sense::click_and_drag(),
20:05:36 out   );
20:05:36 out   let hovered = response.hovered();
20:05:36 out   let selected = self.selected == index;
20:05:36 out   let found = self
20:05:36 out   .library
20:05:36 out   .as_ref()
20:05:36 out   .map(|lib| lib.has_disc(disc))
20:05:36 out   .unwrap_or(false);
20:05:36 out   let painter = ui.painter();
20:05:36 out   let bg = if selected {
20:05:36 out   Color32::from_rgb(49, 43, 29)
20:05:36 out   } else if hovered {
20:05:36 out   Color32::from_rgb(43, 47, 55)
20:05:36 out   } else {
20:05:36 out   PANEL_DARK
20:05:36 out   };
20:05:36 out   painter.rect_filled(rect, 0.0, bg);
20:05:36 out   painter.rect_stroke(
20:05:36 out   rect,
20:05:36 out   0.0,
20:05:36 out   Stroke::new(
20:05:36 out   if selected { 2.0_f32 } else { 1.0_f32 },
20:05:36 out   if selected { GOLD } else { OUTLINE },
20:05:36 out   ),
20:05:36 out   );
20:05:36 out   style::paint_bevel(painter, rect.shrink(1.0), 1.0);
20:05:36 out   let slot = Rect::from_center_size(
20:05:36 out   Pos2::new(rect.center().x, rect.top() + 8.0 + disc_size * 0.5),
20:05:36 out   Vec2::splat(disc_size + 10.0),
20:05:36 out   );
20:05:36 out   painter.rect_filled(slot, 0.0, SLOT);
20:05:36 out   painter.rect_stroke(
20:05:36 out   slot,
20:05:36 out   0.0,
20:05:36 out   Stroke::new(1.0_f32, Color32::from_rgb(40, 43, 50)),
20:05:36 out   );
20:05:36 out   let disc_rect =
20:05:36 out   Rect::from_center_size(slot.center(), Vec2::splat(disc_size));
20:05:36 out   let tint = if found || self.library.is_none() {
20:05:36 out   Color32::WHITE
20:05:36 out   } else {
20:05:36 out   Color32::from_gray(82)
20:05:36 out   };
20:05:36 out   painter.image(
20:05:36 out   self.textures.discs[index].id(),
20:05:36 out   disc_rect,
20:05:36 out   Rect::from_min_max(Pos2::ZERO, Pos2::new(1.0, 1.0)),
20:05:36 out   tint,
20:05:36 out   );
20:05:36 out   let dot = Rect::from_min_size(
20:05:36 out   Pos2::new(rect.right() - 10.0, rect.top() + 7.0),
20:05:36 out   Vec2::splat(4.0),
20:05:36 out   );
20:05:36 out   painter.rect_filled(
20:05:36 out   dot,
20:05:36 out   0.0,
20:05:36 out   if found {
20:05:36 out   GREEN
20:05:36 out   } else if self.library.is_some() {
20:05:36 out   RED
20:05:36 out   } else {
20:05:36 out   MUTED_DARK
20:05:36 out   },
20:05:36 out   );
20:05:36 out   let title_y = slot.bottom() + 7.0;
20:05:36 out   let title_size = if disc.title.len() > 14 {
20:05:36 out   6.0
20:05:36 out   } else if disc.title.len() > 10 {
20:05:36 out   7.0
20:05:36 out   } else {
20:05:36 out   8.0
20:05:36 out   };
20:05:36 out   let title_font = FontId::proportional(title_size);
20:05:36 out   let wrap_width = (card_w - 8.0).max(40.0);
20:05:36 out   let title_color = if selected { GOLD } else { TEXT };
20:05:36 out   let title = painter.layout(
20:05:36 out   disc.title.to_owned(),
20:05:36 out   title_font.clone(),
20:05:36 out   title_color,
20:05:36 out   wrap_width,
20:05:36 out   );
20:05:36 out   let title_shadow = painter.layout(
20:05:36 out   disc.title.to_owned(),
20:05:36 out   title_font,
20:05:36 out   Color32::from_black_alpha(200),
20:05:36 out   wrap_width,
20:05:36 out   );
20:05:36 out   let title_x = rect.center().x - title.size().x / 2.0;
20:05:36 out   painter.galley(
20:05:36 out   Pos2::new(title_x + 1.0, title_y + 1.0),
20:05:36 out   title_shadow,
20:05:36 out   Color32::PLACEHOLDER,
20:05:36 out   );
20:05:36 out   let title_h = title.size().y;
20:05:36 out   painter.galley(
20:05:36 out   Pos2::new(title_x, title_y),
20:05:36 out   title,
20:05:36 out   Color32::PLACEHOLDER,
20:05:36 out   );
20:05:36 out   let artist_y = title_y + title_h + 3.0;
20:05:36 out   painter.text(
20:05:36 out   Pos2::new(rect.center().x, artist_y),
20:05:36 out   Align2::CENTER_TOP,
20:05:36 out   disc.artist,
20:05:36 out   FontId::proportional(6.0),
20:05:36 out   MUTED,
20:05:36 out   );
20:05:36 out   let status_y = artist_y + 10.0;
20:05:36 out   if self.library.is_some() && !found {
20:05:36 out   painter.text(
20:05:36 out   Pos2::new(rect.center().x, status_y),
20:05:36 out   Align2::CENTER_TOP,
20:05:36 out   "MISSING",
20:05:36 out   FontId::proportional(5.0),
20:05:36 out   RED,
20:05:36 out   );
20:05:36 out   } else if selected {
20:05:36 out   painter.text(
20:05:36 out   Pos2::new(rect.center().x, status_y),
20:05:36 out   Align2::CENTER_TOP,
20:05:36 out   "SELECTED",
20:05:36 out   FontId::proportional(5.0),
20:05:36 out   GOLD,
20:05:36 out   );
20:05:36 out   }
20:05:36 out   if hovered {
20:05:36 out   ui.ctx().set_cursor_icon(CursorIcon::PointingHand);
20:05:36 out   }
20:05:36 out   if response.clicked() {
20:05:36 out   clicked_select = Some(index);
20:05:36 out   }
20:05:36 out   if response.double_clicked() {
20:05:36 out   double_click = Some(index);
20:05:36 out   }
20:05:36 out   if response.drag_started() {
20:05:36 out   drag_start = Some(index);
20:05:36 out   }
20:05:36 out   if response.dragged() {
20:05:36 out   drag_update = ui.ctx().pointer_latest_pos();
20:05:36 out   }
20:05:36 out   if response.drag_stopped() {
20:05:36 out   drag_stop = Some((index, ui.ctx().pointer_latest_pos()));
20:05:36 out   }
20:05:36 out   }
20:05:36 out   });
20:05:36 out   }
20:05:36 out   ui.spacing_mut().item_spacing = Vec2::new(8.0, 8.0);
20:05:36 out   });
20:05:36 out   });
20:05:36 out   style::paint_bevel(ui.painter(), outer.response.rect.shrink(2.0), 2.0);
20:05:36 out   ui.painter().rect_stroke(
20:05:36 out   outer.response.rect.shrink(5.0),
20:05:36 out   0.0,
