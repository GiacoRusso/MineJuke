18:00:15 out   pub const PIXEL_FONT: &[u8] = include_bytes!("../assets/PressStart2P-Regular.ttf");
18:00:15 out   pub fn install_fonts(ctx: &egui::Context) {
18:00:15 out   let mut fonts = FontDefinitions::default();
18:00:15 out   fonts.font_data.insert(
18:00:15 out   "press-start-2p".to_owned(),
18:00:15 out   FontData::from_static(PIXEL_FONT),
18:00:15 out   );
18:00:15 out   for family in [FontFamily::Proportional, FontFamily::Monospace] {
18:00:15 out   if let Some(list) = fonts.families.get_mut(&family) {
18:00:15 out   list.insert(0, "press-start-2p".to_owned());
18:00:15 out   }
18:00:15 out   }
18:00:15 out   ctx.set_fonts(fonts);
18:00:15 out   }
18:00:15 out   pub fn apply_visuals(ctx: &egui::Context) {
18:00:15 out   let mut visuals = egui::Visuals::dark();
18:00:15 out   visuals.override_text_color = Some(TEXT);
18:00:15 out   visuals.panel_fill = Color32::TRANSPARENT;
18:00:15 out   visuals.window_fill = PANEL;
18:00:15 out   visuals.extreme_bg_color = PANEL_DEEP;
18:00:15 out   visuals.faint_bg_color = PANEL_DARK;
18:00:15 out   visuals.widgets.noninteractive.bg_fill = PANEL;
18:00:15 out   visuals.widgets.noninteractive.fg_stroke = Stroke::new(1.0_f32, TEXT);
18:00:15 out   visuals.widgets.inactive.bg_fill = BUTTON;
18:00:15 out   visuals.widgets.hovered.bg_fill = BUTTON_HOVER;
18:00:15 out   visuals.widgets.active.bg_fill = BUTTON_PRESSED;
18:00:15 out   visuals.selection.bg_fill = GOLD_DARK;
18:00:15 out   visuals.selection.stroke = Stroke::new(1.0_f32, GOLD);
18:00:15 out   ctx.set_visuals(visuals);
18:00:15 out   ctx.style_mut(|style| {
18:00:15 out   style.spacing.item_spacing = Vec2::new(8.0, 8.0);
18:00:15 out   style.spacing.button_padding = Vec2::new(8.0, 4.0);
18:00:15 out   style.animation_time = 0.08;
18:00:15 out   });
18:00:15 out   }
18:00:15 out   pub fn paint_bevel(painter: &egui::Painter, rect: Rect, thickness: f32) {
18:00:15 out   let t = thickness.max(1.0);
18:00:15 out   painter.rect_filled(
18:00:15 out   Rect::from_min_size(rect.min, Vec2::new(rect.width(), t)),
18:00:15 out   0.0,
18:00:15 out   BEVEL_LIGHT,
18:00:15 out   );
18:00:15 out   painter.rect_filled(
18:00:15 out   Rect::from_min_size(rect.min, Vec2::new(t, rect.height())),
18:00:15 out   0.0,
18:00:15 out   BEVEL_LIGHT,
18:00:15 out   );
18:00:15 out   painter.rect_filled(
18:00:15 out   Rect::from_min_size(
18:00:15 out   Pos2::new(rect.left(), rect.bottom() - t),
18:00:15 out   Vec2::new(rect.width(), t),
18:00:15 out   ),
18:00:15 out   0.0,
18:00:15 out   BEVEL_DARK,
18:00:15 out   );
18:00:15 out   painter.rect_filled(
18:00:15 out   Rect::from_min_size(
18:00:15 out   Pos2::new(rect.right() - t, rect.top()),
18:00:15 out   Vec2::new(t, rect.height()),
18:00:15 out   ),
18:00:15 out   0.0,
18:00:15 out   BEVEL_DARK,
18:00:15 out   );
18:00:15 out   }
18:00:15 out   pub fn pixel_text(
18:00:15 out   painter: &egui::Painter,
18:00:15 out   pos: Pos2,
18:00:15 out   align: Align2,
18:00:15 out   text: &str,
18:00:15 out   size: f32,
18:00:15 out   color: Color32,
18:00:15 out   ) {
18:00:15 out   let font = FontId::proportional(size);
18:00:15 out   painter.text(
18:00:15 out   pos + Vec2::new(1.5, 1.5),
18:00:15 out   align,
18:00:15 out   text,
18:00:15 out   font.clone(),
18:00:15 out   Color32::from_black_alpha(210),
18:00:15 out   );
18:00:15 out   painter.text(pos, align, text, font, color);
18:00:15 out   }
18:00:15 out   pub fn pixel_label(ui: &mut Ui, text: &str, size: f32, color: Color32) -> Response {
18:00:15 out   let font = FontId::proportional(size);
18:00:15 out   let galley = ui
18:00:15 out   .painter()
18:00:15 out   .layout_no_wrap(text.to_owned(), font.clone(), color);
18:00:15 out   let galley_size = galley.size();
18:00:15 out   let (rect, response) =
18:00:15 out   ui.allocate_exact_size(galley_size + Vec2::new(2.0, 2.0), Sense::hover());
18:00:15 out   let painter = ui.painter();
18:00:15 out   let shadow = painter.layout_no_wrap(text.to_owned(), font, Color32::from_black_alpha(200));
18:00:15 out   painter.galley(rect.min + Vec2::new(1.5, 1.5), shadow, Color32::PLACEHOLDER);
18:00:15 out   painter.galley(rect.min, galley, Color32::PLACEHOLDER);
18:00:15 out   response
18:00:15 out   }
18:00:15 out   pub fn mc_button(ui: &mut Ui, label: &str, size: Vec2, enabled: bool) -> Response {
18:00:15 out   let sense = if enabled {
18:00:15 out   Sense::click()
18:00:15 out   } else {
18:00:15 out   Sense::hover()
18:00:15 out   };
18:00:15 out   let (rect, response) = ui.allocate_exact_size(size, sense);
18:00:15 out   let hovered = enabled && response.hovered();
18:00:15 out   let pressed = enabled && response.is_pointer_button_down_on();
18:00:15 out   let fill = if !enabled {
18:00:15 out   BUTTON_DISABLED
18:00:15 out   } else if pressed {
18:00:15 out   BUTTON_PRESSED
18:00:15 out   } else if hovered {
18:00:15 out   BUTTON_HOVER
18:00:15 out   } else {
18:00:15 out   BUTTON
18:00:15 out   };
18:00:15 out   let painter = ui.painter();
18:00:15 out   painter.rect_filled(rect, 0.0, fill);
18:00:15 out   painter.rect_stroke(rect, 0.0, Stroke::new(2.0_f32, OUTLINE));
18:00:15 out   if pressed {
18:00:15 out   // inverted bevel
18:00:15 out   painter.rect_filled(
18:00:15 out   Rect::from_min_size(
18:00:15 out   rect.min + Vec2::splat(2.0),
18:00:15 out   Vec2::new(rect.width() - 4.0, 2.0),
18:00:15 out   ),
18:00:15 out   0.0,
18:00:15 out   BEVEL_DARK,
18:00:15 out   );
18:00:15 out   painter.rect_filled(
18:00:15 out   Rect::from_min_size(
18:00:15 out   rect.min + Vec2::splat(2.0),
18:00:15 out   Vec2::new(2.0, rect.height() - 4.0),
18:00:15 out   ),
18:00:15 out   0.0,
18:00:15 out   BEVEL_DARK,
18:00:15 out   );
18:00:15 out   painter.rect_filled(
18:00:15 out   Rect::from_min_size(
18:00:15 out   Pos2::new(rect.left() + 2.0, rect.bottom() - 4.0),
18:00:15 out   Vec2::new(rect.width() - 4.0, 2.0),
18:00:15 out   ),
18:00:15 out   0.0,
18:00:15 out   BEVEL_LIGHT,
18:00:15 out   );
18:00:15 out   painter.rect_filled(
18:00:15 out   Rect::from_min_size(
18:00:15 out   Pos2::new(rect.right() - 4.0, rect.top() + 2.0),
18:00:15 out   Vec2::new(2.0, rect.height() - 4.0),
18:00:15 out   ),
18:00:15 out   0.0,
18:00:15 out   BEVEL_LIGHT,
18:00:15 out   );
18:00:15 out   } else {
18:00:15 out   paint_bevel(painter, rect.shrink(2.0), 2.0);
18:00:15 out   }
18:00:15 out   if hovered {
18:00:15 out   painter.rect_stroke(
18:00:15 out   rect.shrink(1.0),
18:00:15 out   0.0,
18:00:15 out   Stroke::new(1.0_f32, Color32::from_rgba_unmultiplied(255, 255, 255, 48)),
18:00:15 out   );
18:00:15 out   }
18:00:15 out   let text_color = if enabled { TEXT } else { MUTED_DARK };
18:00:15 out   let text_pos = rect.center()
18:00:15 out   + if pressed {
18:00:15 out   Vec2::new(1.0, 1.0)
18:00:15 out   } else {
18:00:15 out   Vec2::ZERO
18:00:15 out   };
18:00:15 out   pixel_text(
18:00:15 out   painter,
18:00:15 out   text_pos,
18:00:15 out   Align2::CENTER_CENTER,
18:00:15 out   label,
18:00:15 out   if label.len() > 16 { 6.0 } else { 7.0 },
18:00:15 out   text_color,
18:00:15 out   );
18:00:15 out   response
18:00:15 out   }
