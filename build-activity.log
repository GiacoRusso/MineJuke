18:00:15 out   pub fn format_time(seconds: f32) -> String {
18:00:15 out   if !seconds.is_finite() || seconds <= 0.0 {
18:00:15 out   return "0:00".to_string();
18:00:15 out   }
18:00:15 out   let total = seconds.round() as u64;
18:00:15 out   format!("{}:{:02}", total / 60, total % 60)
18:00:15 out   }
18:00:15 out   #[cfg(test)]
18:00:15 out   mod tests {
18:00:15 out   use super::*;
18:00:15 out   #[test]
18:00:15 out   fn catalogue_is_complete_and_unique() {
18:00:15 out   assert_eq!(DISCS.len(), 18);
18:00:15 out   let mut ids = std::collections::HashSet::new();
18:00:15 out   for disc in DISCS {
18:00:15 out   assert!(ids.insert(disc.id), "duplicate disc id {}", disc.id);
18:00:15 out   assert!(!disc.title.is_empty());
18:00:15 out   assert!(!disc.artist.is_empty());
18:00:15 out   }
18:00:15 out   }
18:00:15 out   #[test]
18:00:15 out   fn time_formatting() {
18:00:15 out   assert_eq!(format_time(0.0), "0:00");
18:00:15 out   assert_eq!(format_time(9.6), "0:10");
18:00:15 out   assert_eq!(format_time(125.2), "2:05");
18:00:15 out   }
18:00:15 out   }
