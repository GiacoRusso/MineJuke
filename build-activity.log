18:00:15 out   self.notes.push(Note {
18:00:15 out   x,
18:00:15 out   y,
18:00:15 out   vy: NOTE_RISE * (0.85 + r4 * 0.45),
18:00:15 out   sway: 5.0 + r1 * 9.0,
18:00:15 out   phase: r2 * std::f32::consts::TAU,
18:00:15 out   life,
18:00:15 out   max_life: life,
18:00:15 out   color,
18:00:15 out   kind: (r4 * 4.0) as u8,
18:00:15 out   });
18:00:15 out   }
18:00:15 out   }
