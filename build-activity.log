18:00:15 out   self.anim_t = 1.0;
18:00:15 out   self.state = JukeboxState::Playing;
18:00:15 out   self.anim_t = 0.0;
18:00:15 out   if let Some(err) = self.player.audio_error.take() {
18:00:15 out   self.set_toast(format!("Playing without sound: {err}"));
18:00:15 out   }
18:00:15 out   }
18:00:15 out   }
18:00:15 out   JukeboxState::Playing => {
18:00:15 out   self.player.advance(Duration::from_secs_f32(dt));
18:00:15 out   self.spawn_notes(dt);
18:00:15 out   if self.player.is_finished() {
18:00:15 out   if self.repeat {
18:00:15 out   self.replay_current();
18:00:15 out   } else {
18:00:15 out   self.eject();
18:00:15 out   }
18:00:15 out   }
18:00:15 out   }
18:00:15 out   JukeboxState::Ejecting => {
18:00:15 out   self.anim_t += dt / EJECT_SECS;
18:00:15 out   if self.anim_t >= 1.0 {
18:00:15 out   self.anim_t = 1.0;
18:00:15 out   self.state = JukeboxState::Idle;
18:00:15 out   self.inserted = None;
18:00:15 out   self.anim_t = 0.0;
18:00:15 out   }
18:00:15 out   }
18:00:15 out   JukeboxState::Idle => {}
18:00:15 out   }
18:00:15 out   for note in &mut self.notes {
18:00:15 out   note.life -= dt;
18:00:15 out   note.y -= note.vy * dt;
18:00:15 out   note.x += (note.phase + self.anim_time * 3.2).sin() * note.sway * dt;
18:00:15 out   }
18:00:15 out   self.notes.retain(|n| n.life > 0.0);
18:00:15 out   }
18:00:15 out   fn next_random(&mut self) -> f32 {
18:00:15 out   self.rng = self.rng.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);
18:00:15 out   (self.rng >> 8) as f32 / 16_777_216.0
18:00:15 out   }
18:00:15 out   fn spawn_notes(&mut self, dt: f32) {
18:00:15 out   self.note_accum += dt;
18:00:15 out   while self.note_accum >= NOTE_INTERVAL {
18:00:15 out   self.note_accum -= NOTE_INTERVAL;
18:00:15 out   if self.notes.len() >= MAX_NOTES {
18:00:15 out   continue;
18:00:15 out   }
18:00:15 out   let rect = if self.jukebox_rect.is_positive() {
18:00:15 out   self.jukebox_rect
18:00:15 out   } else {
18:00:15 out   Rect::from_center_size(Pos2::new(590.0, 420.0), Vec2::splat(250.0))
18:00:15 out   };
18:00:15 out   let r1 = self.next_random();
18:00:15 out   let r2 = self.next_random();
18:00:15 out   let r3 = self.next_random();
18:00:15 out   let r4 = self.next_random();
18:00:15 out   let disc = self.inserted.map(|i| DISCS[i]).unwrap_or(DISCS[0]);
18:00:15 out   let palette = [GOLD, CYAN, MAGENTA, GREEN, ORANGE, PURPLE, TEXT];
18:00:15 out   let base = palette[(r4 * palette.len() as f32) as usize % palette.len()];
18:00:15 out   let accent = Color32::from_rgb(disc.accent.0, disc.accent.1, disc.accent.2);
18:00:15 out   let color = if r3 > 0.55 { accent } else { base };
