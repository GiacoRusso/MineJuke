18:07:33 out   [0m$ [0mcd "/Users/giacomorusso/Documents/Craft Anything/build-a-native-macos-desktop/app" && python3 - <<'PY'
18:07:33 out   from PIL import Image
18:07:33 out   im=Image.open('shots/now.png').convert('RGB')
18:07:33 out   w,h=im.size
18:07:33 out   px=im.load()
18:07:33 out   # find bounding boxes of panel color 30,33,40 and wood-ish colors
18:07:33 out   def bbox(pred, step=2):
18:07:33 out   minx,miny,maxx,maxy=w,h,-1,-1
18:07:33 out   n=0
18:07:33 out   for y in range(0,h,step):
18:07:33 out   for x in range(0,w,step):
18:07:33 out   if pred(px[x,y]):
18:07:33 out   n+=1
18:07:33 out   minx=min(minx,x); maxx=max(maxx,x); miny=min(miny,y); maxy=max(maxy,y)
18:07:33 out   return (minx,miny,maxx,maxy,n)
18:07:33 out   print('panel', bbox(lambda c: c==(30,33,40)))
18:07:33 out   print('gold', bbox(lambda c: c[0]>220 and c[1]>170 and c[2]<140, 2))
18:07:33 out   print('green', bbox(lambda c: c[1]>180 and c[0]<160 and c[2]<160, 2))
18:07:33 out   print('white', bbox(lambda c: min(c)>225, 2))
18:07:33 out   # sample grid of average colors per 40px block for y 300..1400
18:07:33 out   for y in range(0,h,100):
18:07:33 out   row=[]
18:07:33 out   for x in range(0,w,200):
18:07:33 out   c=px[x,y]
18:07:33 out   row.append(f"{c[0]:3d},{c[1]:3d},{c[2]:3d}")
18:07:33 out   print(y, ' | '.join(row))
