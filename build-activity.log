17:40:03 out   +fn ogg_granule_duration(path: &Path, sample_rate: u32) -> Option<Duration> {
17:40:03 out   + if sample_rate == 0 {
17:40:03 out   + return None;
17:40:03 out   + }
17:40:03 out   + let bytes = std::fs::read(path).ok()?;
17:40:03 out   + let mut offset = 0usize;
17:40:03 out   + let mut last_granule: Option<u64> = None;
17:40:03 out   + while offset + 27 <= bytes.len() {
17:40:03 out   + if &bytes[offset..offset + 4] != b"OggS" {
17:40:03 out   + break;
17:40:03 out   + }
17:40:03 out   + let granule = i64::from_le_bytes(bytes[offset + 6..offset + 14].try_into().ok()?);
17:40:03 out   + let segments = bytes[offset + 26] as usize;
17:40:03 out   + let table_end = offset + 27 + segments;
17:40:03 out   + if table_end > bytes.len() {
17:40:03 out   + break;
17:40:03 out   + }
17:40:03 out   + let data_len: usize = bytes[offset + 27..table_end]
17:40:03 out   + .iter()
17:40:03 out   + .map(|count| *count as usize)
17:40:03 out   + .sum();
17:40:03 out   + let next = table_end + data_len;
17:40:03 out   + if next > bytes.len() {
17:40:03 out   + break;
17:40:03 out   + }
17:40:03 out   + if granule >= 0 {
17:40:03 out   + last_granule = Some(granule as u64);
17:40:03 out   + }
17:40:03 out   + offset = next;
17:40:03 out   + }
17:40:03 out   + let samples = last_granule?;
17:40:03 out   + Some(Duration::from_secs_f64(samples as f64 / sample_rate as f64))
17:40:03 out   +}
