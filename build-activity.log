18:00:15 out   //! Minecraft Jukebox - a native macOS music disc player.
18:00:15 out   //!
18:00:15 out   //! Run normally:
18:00:15 out   //! cargo run --release
18:00:15 out   //!
18:00:15 out   //! Capture the rendered window (used by the build checker):
18:00:15 out   //! cargo run --release -- --screenshot shots/now.png
18:00:15 out   //!
18:00:15 out   //! Drive the core loop headlessly and write a report:
18:00:15 out   //! cargo run --release -- --self-test shots/self-test.json
18:00:15 out   mod app;
18:00:15 out   mod assets;
18:00:15 out   mod disc;
18:00:15 out   mod player;
18:00:15 out   mod selftest;
18:00:15 out   mod style;
18:00:15 out   mod textures;
18:00:15 out   use app::{JukeboxApp, Startup, MIN_WINDOW_H, MIN_WINDOW_W, WINDOW_H, WINDOW_W};
18:00:15 out   use std::path::PathBuf;
18:00:15 out   fn main() -> eframe::Result<()> {
18:00:15 out   let mut screenshot = None;
18:00:15 out   let mut self_test = None;
18:00:15 out   let mut args = std::env::args().skip(1);
18:00:15 out   while let Some(arg) = args.next() {
18:00:15 out   match arg.as_str() {
18:00:15 out   "--screenshot" => {
18:00:15 out   screenshot = args.next().map(PathBuf::from);
18:00:15 out   if screenshot.is_none() {
18:00:15 out   eprintln!("--screenshot needs a PNG path");
18:00:15 out   std::process::exit(2);
18:00:15 out   }
18:00:15 out   }
18:00:15 out   "--self-test" => {
18:00:15 out   self_test = args.next().map(PathBuf::from);
18:00:15 out   if self_test.is_none() {
18:00:15 out   eprintln!("--self-test needs a JSON path");
18:00:15 out   std::process::exit(2);
18:00:15 out   }
18:00:15 out   }
18:00:15 out   "--help" | "-h" => {
18:00:15 out   println!("Minecraft Jukebox");
18:00:15 out   println!(" --screenshot <file.png> draw 120 frames, save a PNG and exit");
18:00:15 out   println!(" --self-test <file.json> run the headless core-loop test and exit");
18:00:15 out   return Ok(());
18:00:15 out   }
18:00:15 out   _ => {}
18:00:15 out   }
18:00:15 out   }
18:00:15 out   if let Some(path) = self_test {
18:00:15 out   if !selftest::run(path) {
18:00:15 out   std::process::exit(1);
18:00:15 out   }
18:00:15 out   return Ok(());
18:00:15 out   }
18:00:15 out   let options = eframe::NativeOptions {
18:00:15 out   viewport: eframe::egui::ViewportBuilder::default()
18:00:15 out   .with_title("Minecraft Jukebox")
18:00:15 out   .with_inner_size([WINDOW_W, WINDOW_H])
18:00:15 out   .with_min_inner_size([MIN_WINDOW_W, MIN_WINDOW_H])
18:00:15 out   .with_resizable(true),
