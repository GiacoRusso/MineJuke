17:40:45 out   fn newest_index(indexes_dir: &Path) -> Result<(PathBuf, String, usize)> {
17:40:45 out   let mut candidates: Vec<(SystemTime, PathBuf)> = Vec::new();
17:40:45 out   for entry in std::fs::read_dir(indexes_dir)? {
17:40:45 out   let entry = entry?;
17:40:45 out   let path = entry.path();
17:40:45 out   if path.extension().and_then(|s| s.to_str()) != Some("json") {
17:40:45 out   continue;
17:40:45 out   }
17:40:45 out   let modified = entry
17:40:45 out   .metadata()
17:40:45 out   .and_then(|m| m.modified())
17:40:45 out   .unwrap_or(SystemTime::UNIX_EPOCH);
17:40:45 out   candidates.push((modified, path));
17:40:45 out   }
17:40:45 out   if candidates.is_empty() {
17:40:45 out   return Err(anyhow!("the folder contains no .json asset indexes"));
17:40:45 out   }
17:40:45 out   let count = candidates.len();
17:40:45 out   candidates.sort_by(|a, b| b.0.cmp(&a.0));
17:40:45 out   // Prefer the newest modified index, but fall back to a numeric version
17:40:45 out   // comparison if several indexes were copied at the same time.
17:40:45 out   let newest = candidates
17:40:45 out   .iter()
17:40:45 out   .max_by(|a, b| {
17:40:45 out   let av = version_number(&a.1);
17:40:45 out   let bv = version_number(&b.1);
17:40:45 out   av.cmp(&bv).then_with(|| a.0.cmp(&b.0))
17:40:45 out   })
17:40:45 out   .map(|(_, p)| p.clone())
17:40:45 out   .unwrap_or_else(|| candidates[0].1.clone());
17:40:45 out   let name = newest
17:40:45 out   .file_stem()
17:40:45 out   .and_then(|s| s.to_str())
17:40:45 out   .unwrap_or("assets")
17:40:45 out   .to_string();
17:40:45 out   Ok((newest, name, count))
17:40:45 out   }
17:40:45 out   fn version_number(path: &Path) -> u64 {
17:40:45 out   path.file_stem()
17:40:45 out   .and_then(|s| s.to_str())
17:40:45 out   .and_then(|s| s.parse::<u64>().ok())
17:40:45 out   .unwrap_or(0)
17:40:45 out   }
