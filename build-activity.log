18:00:15 out   ---ASSETS---
18:00:15 out   //! Locating the Minecraft Java assets without copying or modifying them.
18:00:15 out   //!
18:00:15 out   //! Minecraft keeps downloaded assets in a content-addressed store:
18:00:15 out   //! assets/indexes/<version>.json
18:00:15 out   //! assets/objects/<first two hash chars>/<hash>
18:00:15 out   //! The index tells us which object is `minecraft/sounds/records/cat.ogg`.
18:00:15 out   use anyhow::{anyhow, Context, Result};
18:00:15 out   use serde::Deserialize;
18:00:15 out   use std::collections::HashMap;
18:00:15 out   use std::path::{Path, PathBuf};
18:00:15 out   use std::time::SystemTime;
18:00:15 out   use crate::disc::{Disc, DISCS};
18:00:15 out   #[derive(Debug, Deserialize)]
18:00:15 out   struct AssetIndex {
18:00:15 out   #[serde(default)]
18:00:15 out   objects: HashMap<String, AssetObject>,
18:00:15 out   }
18:00:15 out   #[derive(Debug, Deserialize)]
18:00:15 out   struct AssetObject {
18:00:15 out   hash: String,
18:00:15 out   }
18:00:15 out   #[derive(Debug, Clone)]
18:00:15 out   pub struct AssetLibrary {
18:00:15 out   pub index_name: String,
18:00:15 out   /// Number of index JSON files found; shown in the setup screen.
18:00:15 out   pub index_count: usize,
18:00:15 out   /// disc id -> absolute path to the .ogg object.
18:00:15 out   pub records: HashMap<String, PathBuf>,
18:00:15 out   }
18:00:15 out   impl AssetLibrary {
18:00:15 out   /// Accepts either the `.minecraft` folder or its `assets` child.
18:00:15 out   pub fn load(selected: &Path) -> Result<Self> {
18:00:15 out   let assets_dir = if selected.file_name().and_then(|s| s.to_str()) == Some("assets") {
18:00:15 out   selected.to_path_buf()
18:00:15 out   } else {
18:00:15 out   selected.join("assets")
18:00:15 out   };
18:00:15 out   let indexes_dir = assets_dir.join("indexes");
18:00:15 out   if !indexes_dir.is_dir() {
18:00:15 out   return Err(anyhow!(
18:00:15 out   "No assets/indexes folder was found in {}",
18:00:15 out   selected.display()
18:00:15 out   ));
18:00:15 out   }
18:00:15 out   let (index_path, index_name, index_count) = newest_index(&indexes_dir)
18:00:15 out   .with_context(|| format!("No asset index JSON found in {}", indexes_dir.display()))?;
18:00:15 out   let bytes = std::fs::read(&index_path)
18:00:15 out   .with_context(|| format!("Could not read {}", index_path.display()))?;
18:00:15 out   let index: AssetIndex = serde_json::from_slice(&bytes)
18:00:15 out   .with_context(|| format!("Could not parse {}", index_path.display()))?;
18:00:15 out   let mut records = HashMap::new();
18:00:15 out   for disc in DISCS.iter() {
18:00:15 out   let key = format!("minecraft/sounds/records/{}.ogg", disc.asset);
18:00:15 out   if let Some(object) = index.objects.get(&key) {
18:00:15 out   if object.hash.len() >= 2 {
18:00:15 out   let prefix = &object.hash[0..2];
18:00:15 out   let path = assets_dir.join("objects").join(prefix).join(&object.hash);
18:00:15 out   if path.is_file() {
18:00:15 out   records.insert(disc.id.to_string(), path);
18:00:15 out   }
18:00:15 out   }
18:00:15 out   }
18:00:15 out   }
18:00:15 out   Ok(Self {
18:00:15 out   index_name,
18:00:15 out   index_count,
18:00:15 out   records,
18:00:15 out   })
18:00:15 out   }
18:00:15 out   pub fn found_count(&self) -> usize {
18:00:15 out   self.records.len()
18:00:15 out   }
18:00:15 out   pub fn total_count(&self) -> usize {
18:00:15 out   DISCS.len()
18:00:15 out   }
18:00:15 out   pub fn has_disc(&self, disc: &Disc) -> bool {
18:00:15 out   self.records.contains_key(disc.id)
18:00:15 out   }
18:00:15 out   pub fn record_path(&self, disc: &Disc) -> Option<&Path> {
18:00:15 out   self.records.get(disc.id).map(PathBuf::as_path)
18:00:15 out   }
18:00:15 out   }
18:00:15 out   fn newest_index(indexes_dir: &Path) -> Result<(PathBuf, String, usize)> {
18:00:15 out   let mut candidates: Vec<(SystemTime, PathBuf)> = Vec::new();
18:00:15 out   for entry in std::fs::read_dir(indexes_dir)? {
18:00:15 out   let entry = entry?;
18:00:15 out   let path = entry.path();
18:00:15 out   if path.extension().and_then(|s| s.to_str()) != Some("json") {
18:00:15 out   continue;
18:00:15 out   }
18:00:15 out   let modified = entry
18:00:15 out   .metadata()
18:00:15 out   .and_then(|m| m.modified())
18:00:15 out   .unwrap_or(SystemTime::UNIX_EPOCH);
18:00:15 out   candidates.push((modified, path));
18:00:15 out   }
18:00:15 out   if candidates.is_empty() {
18:00:15 out   return Err(anyhow!("the folder contains no .json asset indexes"));
18:00:15 out   }
18:00:15 out   let count = candidates.len();
18:00:15 out   candidates.sort_by_key(|candidate| std::cmp::Reverse(candidate.0));
18:00:15 out   // Prefer the newest modified index, but fall back to a numeric version
18:00:15 out   // comparison if several indexes were copied at the same time.
18:00:15 out   let newest = candidates
18:00:15 out   .iter()
18:00:15 out   .max_by(|a, b| {
18:00:15 out   let av = version_number(&a.1);
18:00:15 out   let bv = version_number(&b.1);
18:00:15 out   av.cmp(&bv).then_with(|| a.0.cmp(&b.0))
18:00:15 out   })
18:00:15 out   .map(|(_, p)| p.clone())
18:00:15 out   .unwrap_or_else(|| candidates[0].1.clone());
18:00:15 out   let name = newest
18:00:15 out   .file_stem()
18:00:15 out   .and_then(|s| s.to_str())
18:00:15 out   .unwrap_or("assets")
18:00:15 out   .to_string();
18:00:15 out   Ok((newest, name, count))
18:00:15 out   }
18:00:15 out   fn version_number(path: &Path) -> u64 {
18:00:15 out   path.file_stem()
18:00:15 out   .and_then(|s| s.to_str())
18:00:15 out   .and_then(|s| s.parse::<u64>().ok())
18:00:15 out   .unwrap_or(0)
18:00:15 out   }
18:00:15 out   /// `~/Library/Application Support/minecraft` on macOS, with sensible fallbacks.
18:00:15 out   pub fn default_minecraft_dir() -> PathBuf {
18:00:15 out   #[cfg(target_os = "macos")]
18:00:15 out   {
18:00:15 out   if let Some(home) = dirs::home_dir() {
18:00:15 out   return home.join("Library/Application Support/minecraft");
18:00:15 out   }
18:00:15 out   }
18:00:15 out   if let Some(data) = dirs::data_dir() {
18:00:15 out   let p = data.join("minecraft");
18:00:15 out   if p.exists() {
18:00:15 out   return p;
18:00:15 out   }
18:00:15 out   }
18:00:15 out   dirs::home_dir()
18:00:15 out   .unwrap_or_else(|| PathBuf::from("."))
18:00:15 out   .join(".minecraft")
18:00:15 out   }
18:00:15 out   pub fn display_path(path: &Path) -> String {
18:00:15 out   if let Some(home) = dirs::home_dir() {
18:00:15 out   if let Ok(rest) = path.strip_prefix(&home) {
18:00:15 out   return format!("~/{}", rest.display());
18:00:15 out   }
18:00:15 out   }
18:00:15 out   path.display().to_string()
18:00:15 out   }
18:00:15 out   #[cfg(test)]
18:00:15 out   mod tests {
18:00:15 out   use super::*;
18:00:15 out   #[test]
18:00:15 out   fn default_path_is_non_empty() {
18:00:15 out   assert!(!default_minecraft_dir().as_os_str().is_empty());
18:00:15 out   }
18:00:15 out   #[test]
18:00:15 out   fn reads_real_index_when_available() {
18:00:15 out   let dir = default_minecraft_dir();
18:00:15 out   if !dir.join("assets/indexes").is_dir() {
18:00:15 out   return;
18:00:15 out   }
18:00:15 out   let library = AssetLibrary::load(&dir).expect("default Minecraft assets should load");
18:00:15 out   assert!(
18:00:15 out   library.found_count() > 0,
18:00:15 out   "expected at least one record in {}",
18:00:15 out   dir.display()
18:00:15 out   );
18:00:15 out   println!(
18:00:15 out   "loaded index {} with {}/{} records",
18:00:15 out   library.index_name,
18:00:15 out   library.found_count(),
18:00:15 out   library.total_count()
18:00:15 out   );
18:00:15 out   }
18:00:15 out   }
