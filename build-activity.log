20:05:41 out   //! Headless self-test used by Craft Anything.
20:05:41 out   //!
20:05:41 out   //! It drives the same state machine and renders the same egui UI as the real
20:05:41 out   //! app, then measures the result from the app's own fields and paint output.
20:05:41 out   use crate::app::{JukeboxApp, JukeboxState, Startup, WINDOW_H, WINDOW_W};
20:05:41 out   use crate::disc::DISCS;
20:05:41 out   use crate::player::Player;
20:05:41 out   use eframe::egui::{self, Event, Key, Modifiers, Pos2, RawInput, Rect, Vec2};
20:05:41 out   use serde_json::json;
20:05:41 out   use std::path::PathBuf;
20:05:41 out   pub fn run(path: PathBuf) -> bool {
20:05:41 out   let ctx = egui::Context::default();
20:05:41 out   let startup = Startup {
20:05:41 out   screenshot: None,
20:05:41 out   self_test: Some(path.clone()),
20:05:41 out   };
20:05:41 out   let mut app = JukeboxApp::new_with_ctx(&ctx, startup);
20:05:41 out   // The self-test is about the UI/state machine, not about the user's music
20:05:41 out   // collection, so it uses the silent demo timer.
20:05:41 out   app.setup_open = false;
20:05:41 out   app.library = None;
20:05:41 out   app.library_error = None;
20:05:41 out   app.player = Player::simulated();
20:05:41 out   app.demo_mode = true;
20:05:41 out   app.repeat = false;
20:05:41 out   app.config.repeat = false;
20:05:41 out   let screen = Rect::from_min_size(Pos2::ZERO, Vec2::new(WINDOW_W, WINDOW_H));
20:05:41 out   // --- move: arrow key changes the selected disc ---------------------
20:05:41 out   let before = app.selected;
20:05:41 out   let raw = RawInput {
20:05:41 out   screen_rect: Some(screen),
20:05:41 out   events: vec![Event::Key {
20:05:41 out   key: Key::ArrowRight,
20:05:41 out   physical_key: Some(Key::ArrowRight),
20:05:41 out   pressed: true,
20:05:41 out   repeat: false,
20:05:41 out   modifiers: Modifiers::NONE,
20:05:41 out   }],
20:05:41 out   ..Default::default()
20:05:41 out   };
20:05:41 out   let _ = ctx.run(raw, |ctx| app.handle_input(ctx));
20:05:41 out   let moved = app.selected != before;
20:05:41 out   let move_detail = if moved {
20:05:41 out   format!(
20:05:41 out   "arrow key moved selection from {} to {}",
20:05:41 out   DISCS[before].title, DISCS[app.selected].title
20:05:41 out   )
20:05:41 out   } else {
20:05:41 out   "arrow key did not change the selected disc".to_string()
20:05:41 out   };
20:05:41 out   // --- act: space inserts the disc and playback advances -------------
20:05:41 out   let raw = RawInput {
20:05:41 out   screen_rect: Some(screen),
20:05:41 out   events: vec![Event::Key {
20:05:41 out   key: Key::Space,
20:05:41 out   physical_key: Some(Key::Space),
20:05:41 out   pressed: true,
20:05:41 out   repeat: false,
20:05:41 out   modifiers: Modifiers::NONE,
20:05:41 out   }],
20:05:41 out   ..Default::default()
20:05:41 out   };
20:05:41 out   let _ = ctx.run(raw, |ctx| app.handle_input(ctx));
20:05:41 out   for _ in 0..5 {
20:05:41 out   app.advance(0.1);
20:05:41 out   }
20:05:41 out   for _ in 0..20 {
20:05:41 out   app.advance(0.1);
20:05:41 out   }
20:05:41 out   let elapsed = app.player.elapsed().as_secs_f32();
20:05:41 out   let act_ok = app.state == JukeboxState::Playing && elapsed >= 1.5;
20:05:41 out   let act_detail = if act_ok {
20:05:41 out   format!(
20:05:41 out   "inserted {}; playback timer advanced {:.1} s",
20:05:41 out   app.inserted.map(|i| DISCS[i].title).unwrap_or("disc"),
20:05:41 out   elapsed
20:05:41 out   )
20:05:41 out   } else {
20:05:41 out   format!(
20:05:41 out   "state {:?}, playback timer {:.2} s (expected Playing and > 1.5 s)",
20:05:41 out   app.state, elapsed
20:05:41 out   )
20:05:41 out   };
20:05:41 out   // --- hud: render a real frame and look for the on-screen text ------
20:05:41 out   let raw = RawInput {
20:05:41 out   screen_rect: Some(screen),
20:05:41 out   ..Default::default()
20:05:41 out   };
20:05:41 out   let output = ctx.run(raw, |ctx| app.render(ctx));
20:05:41 out   let has_now_playing = output
20:05:41 out   .shapes
20:05:41 out   .iter()
20:05:41 out   .any(|s| shape_has_text(&s.shape, "NOW PLAYING"));
20:05:41 out   let has_track = output
20:05:41 out   .shapes
20:05:41 out   .iter()
20:05:41 out   .any(|s| shape_has_text(&s.shape, "C418 - Cat"));
20:05:41 out   let has_controls = output
20:05:41 out   .shapes
20:05:41 out   .iter()
20:05:41 out   .any(|s| shape_has_text(&s.shape, "REPEAT"))
20:05:41 out   && output
20:05:41 out   .shapes
20:05:41 out   .iter()
20:05:41 out   .any(|s| shape_has_text(&s.shape, "VOL"));
20:05:41 out   let hud_ok = has_now_playing && has_track && has_controls;
20:05:41 out   let hud_detail = if hud_ok {
20:05:41 out   "now-playing line, progress controls and repeat/volume controls were drawn".to_string()
20:05:41 out   } else {
20:05:41 out   format!(
20:05:41 out   "drawn text check: now_playing={has_now_playing}, track={has_track}, controls={has_controls}"
20:05:41 out   )
20:05:41 out   };
20:05:41 out   let all_ok = moved && act_ok && hud_ok;
20:05:41 out   let result = json!({
20:05:41 out   "version": 1,
20:05:41 out   "steps": [
20:05:41 out   {"step": "move", "passed": moved, "detail": move_detail},
20:05:41 out   {"step": "act", "passed": act_ok, "detail": act_detail},
20:05:41 out   {"step": "hud", "passed": hud_ok, "detail": hud_detail}
20:05:41 out   ]
20:05:41 out   });
20:05:41 out   if let Some(parent) = path.parent().filter(|p| !p.as_os_str().is_empty()) {
20:05:41 out   if let Err(err) = std::fs::create_dir_all(parent) {
20:05:41 out   eprintln!("Could not create self-test folder: {err}");
20:05:41 out   return false;
20:05:41 out   }
20:05:41 out   }
20:05:41 out   match std::fs::write(
20:05:41 out   &path,
20:05:41 out   serde_json::to_vec_pretty(&result).unwrap_or_default(),
20:05:41 out   ) {
20:05:41 out   Ok(()) => {
20:05:41 out   eprintln!(
20:05:41 out   "Self-test written to {} ({})",
20:05:41 out   path.display(),
20:05:41 out   if all_ok { "all steps passed" } else { "FAILED" }
20:05:41 out   );
20:05:41 out   all_ok
20:05:41 out   }
20:05:41 out   Err(err) => {
20:05:41 out   eprintln!("Could not write self-test: {err}");
20:05:41 out   false
20:05:41 out   }
20:05:41 out   }
20:05:41 out   }
20:05:41 out   fn shape_has_text(shape: &egui::Shape, needle: &str) -> bool {
20:05:41 out   match shape {
20:05:41 out   egui::Shape::Text(text) => text.galley.text().contains(needle),
20:05:41 out   egui::Shape::Vec(shapes) => shapes.iter().any(|s| shape_has_text(s, needle)),
20:05:41 out   _ => false,
20:05:41 out   }
20:05:41 out   }
