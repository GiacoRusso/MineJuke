18:00:22 out   fn draw_jukebox(&self, painter: &egui::Painter, rect: Rect) {
18:00:22 out   let glow = matches!(self.state, JukeboxState::Inserting | JukeboxState::Playing)
18:00:22 out   && self.inserted.is_some();
18:00:22 out   if glow {
18:00:22 out   for i in 0..4 {
18:00:22 out   let expand = 3.0 + i as f32 * 4.0;
18:00:22 out   painter.rect_filled(
18:00:22 out   rect.expand(expand),
18:00:22 out   8.0,
18:00:22 out   Color32::from_rgba_unmultiplied(255, 205, 90, 12 - i * 2),
18:00:22 out   );
18:00:22 out   }
18:00:22 out   }
18:00:22 out   painter.rect_filled(
18:00:22 out   Rect::from_min_size(rect.min + Vec2::new(8.0, 10.0), rect.size()),
18:00:22 out   0.0,
18:00:22 out   Color32::from_black_alpha(120),
18:00:22 out   );
18:00:22 out   painter.image(
18:00:22 out   self.textures.jukebox.id(),
18:00:22 out   rect,
18:00:22 out   Rect::from_min_max(Pos2::ZERO, Pos2::new(1.0, 1.0)),
18:00:22 out   Color32::WHITE,
18:00:22 out   );
18:00:22 out   let slot = Rect::from_min_max(
18:00:22 out   rect.min + Vec2::new(rect.width() * 0.25, rect.height() * 0.11),
18:00:22 out   rect.min + Vec2::new(rect.width() * 0.75, rect.height() * 0.28),
18:00:22 out   );
18:00:22 out   painter.rect_filled(slot, 0.0, Color32::from_rgba_unmultiplied(0, 0, 0, 130));
18:00:22 out   if let Some(index) = self.inserted {
18:00:22 out   let base_size = rect.width() * 0.34;
18:00:22 out   let (offset, scale, alpha) = match self.state {
18:00:22 out   JukeboxState::Inserting => {
18:00:22 out   let t = ease_out(self.anim_t.clamp(0.0, 1.0));
18:00:22 out   (
18:00:22 out   Vec2::new(0.0, (1.0 - t) * rect.height() * 0.18),
18:00:22 out   0.55 + 0.45 * t,
18:00:22 out   (t * 255.0) as u8,
18:00:22 out   )
18:00:22 out   }
18:00:22 out   JukeboxState::Ejecting => {
18:00:22 out   let t = self.anim_t.clamp(0.0, 1.0);
18:00:22 out   (
18:00:22 out   Vec2::new(0.0, -t * rect.height() * 0.32),
18:00:22 out   1.0 - 0.15 * t,
18:00:22 out   ((1.0 - t) * 255.0) as u8,
18:00:22 out   )
18:00:22 out   }
18:00:22 out   JukeboxState::Playing => {
18:00:22 out   (Vec2::new(0.0, (self.anim_time * 4.0).sin() * 2.0), 1.0, 255)
18:00:22 out   }
18:00:22 out   JukeboxState::Idle => (Vec2::ZERO, 1.0, 255),
18:00:22 out   };
18:00:22 out   let disc_rect =
18:00:22 out   Rect::from_center_size(slot.center() + offset, Vec2::splat(base_size * scale));
18:00:22 out   painter.image(
18:00:22 out   self.textures.discs[index].id(),
18:00:22 out   disc_rect,
18:00:22 out   Rect::from_min_max(Pos2::ZERO, Pos2::new(1.0, 1.0)),
18:00:22 out   Color32::from_white_alpha(alpha),
18:00:22 out   );
18:00:22 out   if matches!(self.state, JukeboxState::Inserting) {
18:00:22 out   let t = self.anim_t.clamp(0.0, 1.0);
18:00:22 out   for i in 0..7 {
18:00:22 out   let angle = i as f32 * 0.9 + self.anim_time * 5.0;
18:00:22 out   let radius = 18.0 + (1.0 - t) * 34.0 + (i % 3) as f32 * 7.0;
18:00:22 out   let p = slot.center()
18:00:22 out   + Vec2::new(angle.cos() * radius, angle.sin() * radius * 0.55);
18:00:22 out   painter.rect_filled(
18:00:22 out   Rect::from_center_size(p, Vec2::splat(4.0)),
18:00:22 out   0.0,
18:00:22 out   Color32::from_rgba_unmultiplied(255, 220, 120, (t * 220.0) as u8),
18:00:22 out   );
18:00:22 out   }
18:00:22 out   }
18:00:22 out   }
18:00:22 out   for note in &self.notes {
18:00:22 out   let alpha = ((note.life / note.max_life).clamp(0.0, 1.0) * 255.0) as u8;
18:00:22 out   let color = Color32::from_rgba_unmultiplied(
18:00:22 out   note.color.r(),
18:00:22 out   note.color.g(),
18:00:22 out   note.color.b(),
18:00:22 out   alpha,
18:00:22 out   );
18:00:22 out   style::draw_music_note(painter, Pos2::new(note.x, note.y), 18.0, color, note.kind);
18:00:22 out   }
18:00:22 out   }
