18:00:15 out   pub const BUTTON_PRESSED: Color32 = Color32::from_rgb(55, 59, 67);
18:00:15 out   pub const BUTTON_DISABLED: Color32 = Color32::from_rgb(48, 51, 58);
18:00:15 out   pub const CYAN: Color32 = Color32::from_rgb(110, 230, 230);
18:00:15 out   pub const MAGENTA: Color32 = Color32::from_rgb(235, 120, 220);
