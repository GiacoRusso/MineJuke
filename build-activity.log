20:05:36 out   pub fn format_time(seconds: f32) -> String {
20:05:36 out   if !seconds.is_finite() || seconds <= 0.0 {
20:05:36 out   return "0:00".to_string();
20:05:36 out   }
20:05:36 out   let total = seconds.round() as u64;
20:05:36 out   format!("{}:{:02}", total / 60, total % 60)
20:05:36 out   }
