20:01:12 out   [package]
20:01:12 out   name = "minecraft-jukebox"
20:01:12 out   version = "1.0.0"
20:01:12 out   edition = "2021"
20:01:12 out   description = "A native Minecraft-styled music disc jukebox for macOS"
20:01:12 out   license = "MIT"
20:01:12 out   # Keep the app a single, standalone Cargo project even though this workspace's
20:01:12 out   # parent folder once carried a virtual workspace manifest. Craft Anything builds
20:01:12 out   # from app/, so the executable must land in app/target.
20:01:12 out   [workspace]
20:01:12 out   [dependencies]
20:01:12 out   eframe = { version = "0.29.1", default-features = false, features = ["glow", "default_fonts"] }
20:01:12 out   egui = "0.29.1"
20:01:12 out   rodio = { version = "0.20.1", default-features = false, features = ["symphonia-vorbis"] }
20:01:12 out   # rodio 0.20's `symphonia-vorbis` feature enables the codec but not the Ogg
20:01:12 out   # container, so pull in the demuxer explicitly.
20:01:12 out   symphonia = { version = "0.5", default-features = false, features = ["ogg", "vorbis"] }
20:01:12 out   serde = { version = "1", features = ["derive"] }
20:01:12 out   serde_json = "1"
20:01:12 out   rfd = { version = "0.17.2", default-features = false }
20:01:12 out   image = { version = "0.25", default-features = false, features = ["png"] }
20:01:12 out   dirs = "6"
20:01:12 out   anyhow = "1"
20:01:12 out   [profile.release]
20:01:12 out   opt-level = 2
20:01:12 out   lto = "thin"
